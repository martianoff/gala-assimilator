package ui

import (
    . "martianoff/gala/std"
)

// ============================================================================
// StubPort — the milestone-1 EnginePort implementation.
//
// It fabricates plausible detection + scan results so the whole UI is
// exercisable end to end before the real engine exists. Every value here is
// invented; nothing reads the filesystem. When the engine lands, an adapter
// over its public port replaces this type and the UI is unchanged.
// ============================================================================

// StubPort carries the language it pretends to detect, so the canned values
// have a single source of truth.
struct StubPort(DetectLang string)

func NewStubPort() EnginePort = StubPort(DetectLang = "Go")

// DetectSource pretends `dir` is a `DetectLang` project (matches the S1
// mockup) unless the path is empty.
func (p StubPort) DetectSource(dir string) SourceInfo {
    if dir == "" {
        return SourceInfo(Lang = "", Marker = "no project", FileCnt = 0, Detected = false)
    }
    return SourceInfo(
        Lang     = p.DetectLang,
        Marker   = "go.mod found",
        FileCnt  = 50,
        Detected = true,
    )
}

// ScanProject returns a canned plan. The summary echoes the target language so
// the async round-trip is observable when S2 renders it.
func (p StubPort) ScanProject(cfg MigrationConfig) ScanOutcome {
    return ScanOutcome(
        UnitCount = 50,
        Summary   = s"50 units → ${cfg.TargetLang}",
    )
}
