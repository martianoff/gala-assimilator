package ui

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-assimilator/app/runview"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    str "martianoff/gala/strings"
)

// ============================================================================
// View — pure Model → Widget.
//
// Responsive: below MinCols×MinRows the whole view collapses to a resize
// notice. S3's split board sits side-by-side when wide and stacks when narrow.
// Every control carries a click contract AND reflects the keyboard focus state,
// so mouse and keyboard reach the same actions. The view renders only plain VM
// structs (from runview.gala); it never touches engine sealed types.
// ============================================================================

func view(m Model) Widget {
    if (m.Cols < MinCols() || m.Rows < MinRows()) {
        return resizeNotice(m)
    }
    val route = m.Screens.Current()
    if (route == RouteS0()) { return s0View(m) }
    if (route == RouteS1()) { return s1View(m) }
    if (route == RouteS2()) { return s2View(m) }
    if (route == RouteS3()) { return s3View(m) }
    if (route == RouteS4()) { return s4View(m) }
    if (route == RouteS5()) { return s5View(m) }
    if (route == RouteS6()) { return s6View(m) }
    if (route == RouteS7()) { return s7View(m) }
    if (route == RouteS8()) { return s8View(m) }
    return resizeNotice(m)
}

// ============================================================================
// S0 — Resume / corrupt-checkpoint launch prompt
// ============================================================================

func s0View(m Model) Widget {
    if (!m.Recent.IsEmpty()) { return s0Recent(m) }
    return m.ResumeOffer match {
        case Some(offer) => {
            if (offer.Kind == "corrupt") { return s0Corrupt(offer) }
            return s0Resume(offer)
        }
        case None() => resizeNotice(m)
    }
}

// s0Recent is the launch recent-projects picker: a selectable list of prior saved
// sessions ("resume <root> — N/M done"), plus a trailing "[ start new project ]"
// action. Cursor + actions are both keyboard- and mouse-reachable.
func s0Recent(m Model) Widget {
    val head = ArrayOf[LayoutChild](
        Fixed(1, headerRow("Resume a saved migration")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  Pick a session to resume, or start a new project:", DefaultStyle().WithDim())),
        Fixed(1, Text("")),
    )
    val sessionRows = ArrayTabulate[LayoutChild](m.Recent.Length(), (i int) => {
        val e = m.Recent.Get(i)
        return Fixed(1, recentRow(e, i == m.RecentCursor, i))
    })
    val newIdx = m.Recent.Length()
    val tail = ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, recentStartNewRow(newIdx == m.RecentCursor, newIdx)),
        Flex(1, Text("")),
        Fixed(1, TextStyled("  ↑/↓ choose · Enter select · q quit", DefaultStyle().WithDim())),
    )
    return Border(Column(head.AppendAll(sessionRows).AppendAll(tail)))
}

func recentRow(e runview.RecentRowVM, selected bool, idx int) Widget {
    val caret = if (selected) "▸ " else "  "
    val text = "  " + caret + "resume " + e.Root + s" — ${e.Done}/${e.Total} done"
    val style = if (selected) DefaultStyle().WithReverse().WithBold() else DefaultStyle().WithFg(BrightGreen())
    return TextStyled(text, style)
        .OnClick(MRecentSelect(Idx = idx))
        .OnDoubleClick(MRecentResume())
}

func recentStartNewRow(selected bool, idx int) Widget {
    val caret = if (selected) "▸ " else "  "
    val style = if (selected) DefaultStyle().WithReverse().WithBold() else DefaultStyle().WithBold().WithFg(BrightCyan())
    return TextStyled("  " + caret + "[ start new project ]", style)
        .OnClick(MRecentSelect(Idx = idx))
        .OnDoubleClick(MRecentStartNew())
}

func s0Resume(offer runview.LoadSummary) Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Saved migration found")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled(s"  A checkpoint exists: ${offer.Done}/${offer.Total} units done.",
            DefaultStyle().WithFg(BrightGreen()))),
        Fixed(1, Text("")),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            Fixed(26, btnWidget(s"resume (${offer.Done}/${offer.Total}) →", true, MResumeAccept())),
            Fixed(2, Text("")),
            Fixed(16, btnWidget("start fresh", false, MStartFresh())),
        ))),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  enter resume · esc start fresh", DefaultStyle().WithDim())),
    )))

func s0Corrupt(offer runview.LoadSummary) Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Saved migration unreadable")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  The checkpoint could not be read:",
            DefaultStyle().WithFg(BrightYellow()))),
        Fixed(1, TextStyled("    " + offer.Reason, DefaultStyle().WithDim())),
        Fixed(1, Text("")),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            Fixed(16, btnWidget("start fresh", true, MStartFresh())),
        ))),
        Fixed(1, TextStyled("  enter / esc start fresh", DefaultStyle().WithDim())),
    )))

func maxI(a int, b int) int = if (a > b) a else b
func minI(a int, b int) int = if (a < b) a else b

// dispPath normalizes a filesystem path for DISPLAY only (back-slashes → forward), so
// a path.Join result on Windows doesn't render mixed separators beside the
// forward-slash source path (e.g. "\root\.assimilator\out"). The real IO paths the
// engine writes to are untouched — this is purely what the user reads on screen.
func dispPath(p string) string = str.S(p).ReplaceAll("\\", "/").ToString()

// spin returns a braille spinner glyph for the given animation frame, so any
// in-progress / loading state visibly rotates instead of looking frozen. Pair it
// with the loading text: s"${spin(m.Frame)} loading…".
func spinFrames() Array[string] =
    ArrayOf[string]("⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏")

func spin(frame int) string = spinFrames().Get(clampIdx(frame, spinFrames().Length()))

// ============================================================================
// S1 — Setup / Interview
// ============================================================================

// s1View groups the interview into SOURCE / TARGET / OPTIONS sections, each a
// cyan heading over indented fields, and closes with a primary scan action and a
// key-hint footer so the keyboard model (tab/arrows/enter) is discoverable.
func s1View(m Model) Widget {
    val options = ArrayOf[LayoutChild](
        Fixed(1, unsupportedRow(m)),
        Fixed(1, ambiguityRow(m)),
        Fixed(1, retryRow(m)),
    )
    // The SOURCE block reflows by origin: a local directory shows the picker + the
    // detection readout; a GitHub URL shows the repo-URL + optional-ref fields.
    val sourceChildren = if (m.OriginGit)
        ArrayOf[LayoutChild](
            Fixed(1, originRow(m)),
            Fixed(1, urlRow(m)),
            Fixed(1, refRow(m)),
        )
    else
        ArrayOf[LayoutChild](
            Fixed(1, originRow(m)),
            Fixed(1, sourceRow(m)),
            Fixed(1, detectedRow(m)),
        )
    val head = ArrayOf[LayoutChild](
        Fixed(1, headerRow("Gala Assimilator — new migration")),
        Fixed(1, sectionRow("SOURCE")),
    ).AppendAll(sourceChildren).AppendAll(ArrayOf[LayoutChild](
        Fixed(1, sectionRow("TARGET")),
        Fixed(1, targetRow(m)),
        Fixed(1, sectionRow("OPTIONS")),
    ))
    val errChildren = if (m.ScanError == "")
        EmptyArray[LayoutChild]()
    else
        scanErrorRows(m)
    val tail = errChildren.AppendAll(ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, scanRow(m)),
        Fixed(1, s1Footer()),
    ))
    val children = head.AppendAll(options).AppendAll(tail)
    return Border(Column(children))
}

// originRow is the source-origin selector: a two-cell radio (local directory vs.
// GitHub URL), reachable by click and by the focus ring's arrows.
func originRow(m Model) Widget {
    val f = m.Focus.IsFocused(PaneOrigin())
    val group = Row(ArrayOf[LayoutChild](
        radioCell(!m.OriginGit, f, "local dir",  MSetOrigin(Git = false)),
        radioCell(m.OriginGit,  f, "GitHub URL", MSetOrigin(Git = true)),
    ))
    return subFieldRowF(m, PaneOrigin(), "Origin", group)
}

// urlRow / refRow are the git-origin text fields. The label is clickable (focus by
// mouse); Tab reaches them too, and a printable key types into the focused field.
// The whole field — the label AND the input box — carries the focus click. A user
// naturally clicks inside the box to type; without a click contract there, the click
// was a no-op and the keystrokes fell through to the still-focused origin radio (where
// a typed 'q' even quit the app). Making the box itself focusable closes that trap.
func urlRow(m Model) Widget {
    val focused = m.Focus.IsFocused(PaneUrl())
    return Row(ArrayOf[LayoutChild](
        focusCaretCell(m, PaneUrl()),
        Fixed(subLabelW(), TextStyled("Repo URL", DefaultStyle().WithDim()).OnClick(MFocusUrl())),
        Flex(1, Input(m.RepoUrl, RuneCount(m.RepoUrl), "https://github.com/owner/repo", focused).OnClick(MFocusUrl())),
    ))
}

func refRow(m Model) Widget {
    val focused = m.Focus.IsFocused(PaneRef())
    return Row(ArrayOf[LayoutChild](
        focusCaretCell(m, PaneRef()),
        Fixed(subLabelW(), TextStyled("Ref (opt)", DefaultStyle().WithDim()).OnClick(MFocusRef())),
        Flex(1, Input(m.RepoRef, RuneCount(m.RepoRef), "default branch", focused).OnClick(MFocusRef())),
    ))
}

// scanErrorRows surfaces a git clone/scan failure inline on S1 (never a silent dead
// end) as a plain-language block: what failed, the underlying reason, and what to
// try next — instead of a single cryptic warning line.
func scanErrorRows(m Model) Array[LayoutChild] =
    ArrayOf[LayoutChild](
        Fixed(1, errLine("✗ Couldn't start the migration", DefaultStyle().WithBold().WithFg(BrightRed()))),
        Fixed(1, errLine("  " + m.ScanError, DefaultStyle().WithFg(BrightYellow()))),
        Fixed(1, errLine(scanErrorHint(m), DefaultStyle().WithDim())),
    )

func errLine(text string, style Style) Widget =
    Row(ArrayOf[LayoutChild](Fixed(4, Text("")), Flex(1, TextStyled(text, style))))

// scanErrorHint tells the user the concrete next step for the origin they chose.
func scanErrorHint(m Model) string =
    if (m.OriginGit) "  Check the repo URL and branch are correct and reachable, then press Enter to retry."
    else "  Check the project folder path, then press Enter to retry."

func headerRow(title string) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Flex(1, TextStyled(title, DefaultStyle().WithBold().WithFg(BrightCyan()))),
        Fixed(8, TextStyled("q quit ", DefaultStyle().WithDim())),
    ))

func s1Footer() Widget =
    TextStyled("  Tab next field · ←/→ change value · Enter scan · q quit", DefaultStyle().WithDim())

// sectionRow is a cyan section heading; the fields beneath it indent one level
// further (subFieldRow) so the grouping reads at a glance.
func sectionRow(title string) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Flex(1, TextStyled(title, DefaultStyle().WithBold().WithFg(BrightCyan()))),
    ))

func subLabelW() int = 14

func subFieldRow(label string, control Widget) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(4, Text("")),
        Fixed(subLabelW(), TextStyled(label, DefaultStyle().WithDim())),
        Flex(1, control),
    ))

// focusCaretCell is the 4-wide leading indent for an S1 field, showing a ▸ marker
// when this field owns keyboard focus — so the currently-focused control is ALWAYS
// visible (the first Tab is predictable), even for plain text / button fields whose
// own highlight is subtle.
func focusCaretCell(m Model, pane string) LayoutChild {
    if (m.Focus.IsFocused(pane)) {
        return Fixed(4, TextStyled("  ▸ ", DefaultStyle().WithBold().WithFg(BrightCyan())))
    }
    return Fixed(4, Text(""))
}

// subFieldRowF is subFieldRow with a focus caret (▸) on the leading indent.
func subFieldRowF(m Model, pane string, label string, control Widget) Widget =
    Row(ArrayOf[LayoutChild](
        focusCaretCell(m, pane),
        Fixed(subLabelW(), TextStyled(label, DefaultStyle().WithDim())),
        Flex(1, control),
    ))

func sourceRow(m Model) Widget {
    val focused = m.Focus.IsFocused(PaneBrowse())
    return Row(ArrayOf[LayoutChild](
        focusCaretCell(m, PaneBrowse()),
        Fixed(subLabelW(), TextStyled("Project", DefaultStyle().WithDim())),
        Flex(1, TextStyled(dispPath(m.SourceDir), DefaultStyle())),
        Fixed(12, btnWidget("browse…", focused, MBrowse())),
    ))
}

func detectedRow(m Model) Widget {
    val info = m.Source
    val text = if (info.Detected)
        s"${info.Lang}  (${info.Marker}, ${info.FileCnt} files)"
    else if (info.Marker == "")
        "—  (no recognised project)"
    else
        "—  (" + info.Marker + ")"
    val mark = if (info.Detected) "✓ " else "✗ "
    val markStyle = if (info.Detected)
        DefaultStyle().WithFg(BrightGreen())
    else
        DefaultStyle().WithFg(BrightYellow())
    // The detection mark sits NEXT TO the detection text (not flush-right), so the
    // ✓/✗ reads as part of the readout it describes.
    return Row(ArrayOf[LayoutChild](
        Fixed(4, Text("")),
        Fixed(subLabelW(), TextStyled("Detected", DefaultStyle().WithDim())),
        Fixed(2, TextStyled(mark, markStyle)),
        Flex(1, TextStyled(text, DefaultStyle())),
    ))
}

func targetRow(m Model) Widget =
    subFieldRowF(m, PaneTarget(), "Language",
        cyclerWidget(m.TargetLang(), m.Focus.IsFocused(PaneTarget()), MCycleTarget()))

func ambiguityRow(m Model) Widget =
    subFieldRowF(m, PaneAmbiguity(), "Ambiguity",
        cyclerWidget(m.Ambiguity(), m.Focus.IsFocused(PaneAmbiguity()), MCycleAmbiguity()))

func unsupportedRow(m Model) Widget {
    val f = m.Focus.IsFocused(PaneUnsupported())
    val isFlag = UnsupportedEq(m.Unsupported, FlagContinue())
    val isSkip = UnsupportedEq(m.Unsupported, SkipUnit())
    val isStop = UnsupportedEq(m.Unsupported, StopAll())
    val group = Row(ArrayOf[LayoutChild](
        radioCell(isFlag, f, "flag & continue", MSetUnsupported(P = FlagContinue())),
        radioCell(isSkip, f, "skip",            MSetUnsupported(P = SkipUnit())),
        radioCell(isStop, f, "stop",            MSetUnsupported(P = StopAll())),
    ))
    return subFieldRowF(m, PaneUnsupported(), "Unsupported", group)
}

func retryControl(m Model) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(7, stepperWidget(m.Retry, m.Focus.IsFocused(PaneRetry()))),
        Fixed(10, TextStyled(" per unit", DefaultStyle().WithDim())),
    ))

func retryRow(m Model) Widget = subFieldRowF(m, PaneRetry(), "Retry", retryControl(m))

// scanRow is the primary action, left-aligned under the form (not floating off to
// the screen edge). With a GitHub origin and no valid repo URL yet, the button is
// shown disabled next to an inline hint that points back at the Repo URL field —
// so a blocked scan reads as "fill that in first", not as a stray placeholder.
func scanRow(m Model) Widget {
    val focused = m.Focus.IsFocused(PaneScan())
    val valid = !m.OriginGit || looksLikeRepoUrl(m.RepoUrl)
    if (m.Scanning) {
        return Row(ArrayOf[LayoutChild](
            focusCaretCell(m, PaneScan()),
            Fixed(22, btnWidget(s"${spin(m.Frame)} scanning…", focused, MNoOp())),
        ))
    }
    if (valid) {
        return Row(ArrayOf[LayoutChild](
            focusCaretCell(m, PaneScan()),
            btnKeyW("scan project", "⏎", focused, MScanRequested()),
        ))
    }
    return Row(ArrayOf[LayoutChild](
        focusCaretCell(m, PaneScan()),
        Fixed(20, disabledBtn("scan project", focused)),
        Fixed(2, Text("")),
        Flex(1, TextStyled("↑ enter a repo URL above first", DefaultStyle().WithFg(BrightYellow()))),
    ))
}

// disabledBtn renders a button-shaped, non-actionable control: same brackets as
// btnWidget but dimmed, so it reads as "not ready" rather than clickable.
func disabledBtn(label string, focused bool) Widget {
    val style = if (focused) DefaultStyle().WithReverse().WithDim() else DefaultStyle().WithDim()
    return TextStyled("[ " + label + " ]", style)
}

// ============================================================================
// S2 — Plan summary
// ============================================================================

func s2View(m Model) Widget = m.Plan match {
    case Some(plan) => m.Workspace match {
        case Some(ws) => s2Board(m, runview.ProjectPlan(ws, plan))
        case None()   => s2Empty(m)
    }
    case None() => s2Empty(m)
}

func s2Empty(m Model) Widget =
    Border(TextStyled("  (no plan — scan a project first)", DefaultStyle().WithDim()))

func s2Board(m Model, pv runview.PlanVM) Widget {
    if (pv.Units == 0) { return s2EmptyPlan(m, pv) }
    // Window the unit list so a large project never pushes the action buttons off
    // screen: show as many rows as the viewport allows, with a "showing N of M" note.
    val total = pv.Items.Length()
    // Reserve rows for the header block (~8), the preflight block, footer + buttons.
    val reserve = if (m.Preflight == "") 12 else 16
    val avail = maxI(1, m.Rows - reserve)
    val shown = minI(total, avail)
    val itemRows = ArrayTabulate[LayoutChild](shown, (i int) =>
        Fixed(1, TextStyled("   • " + pv.Items.Get(i), DefaultStyle())))
    val showingNote = ArrayOf[LayoutChild](
        Fixed(1, TextStyled(s"  showing ${shown} of ${total}", DefaultStyle().WithDim())))
    val head = ArrayOf[LayoutChild](
        Fixed(1, headerRow("Migration plan")),
        Fixed(1, Text("")),
        Fixed(1, kvRow("Source", dispPath(m.SourceDir))),
        Fixed(1, kvRow("Output", dispPath(OutputDir(m.SourceDir)))),
        Fixed(1, kvRow("Packages", s"${pv.Packages}     Units ${pv.Units}")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  Units to migrate:", DefaultStyle().WithDim())),
    )
    val foot = preflightRows(m).AppendAll(ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, s2Buttons(m)),
    ))
    val children = head.AppendAll(itemRows).AppendAll(showingNote).AppendAll(foot)
    return Border(Column(children))
}

// preflightRows surfaces a BLOCKED start (the checkpoint location isn't writable):
// what's wrong, the underlying reason, and the concrete next step — so a run that
// won't start reads as "pick a writable location", never a silent dead click.
func preflightRows(m Model) Array[LayoutChild] {
    if (m.Preflight == "") { return EmptyArray[LayoutChild]() }
    return ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, errLine("✗ Can't save progress here", DefaultStyle().WithBold().WithFg(BrightRed()))),
        Fixed(1, errLine("  " + dispPath(CheckpointDir(m.SourceDir)) + " — " + m.Preflight, DefaultStyle().WithFg(BrightYellow()))),
        Fixed(1, errLine("  Choose a writable project location, then start again.", DefaultStyle().WithDim())),
    )
}

// s2EmptyPlan is the "we scanned, but there's nothing to migrate" state. The
// scan succeeded — it just found no source units — so this is a dead end the
// user must back out of, not a run to start. There is no start affordance, only
// a clear explanation and a way back to pick another folder.
func s2EmptyPlan(m Model, pv runview.PlanVM) Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Migration plan — nothing to migrate")),
        Fixed(1, Text("")),
        Fixed(1, kvRow("Source", dispPath(m.SourceDir))),
        Fixed(1, kvRow("Scanned", s"${pv.Packages} packages · 0 migratable units")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  ⚠ No migratable units were found in this project.",
            DefaultStyle().WithBold().WithFg(BrightYellow()))),
        Fixed(1, TextStyled("    This folder doesn't look like a Go source project",
            DefaultStyle().WithDim())),
        Fixed(1, TextStyled("    — no .go files were detected under it.",
            DefaultStyle().WithDim())),
        Fixed(1, Text("")),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            Fixed(30, btnWidget("← back & choose a folder", true, MBack())),
            Flex(1, Text("")),
        ))),
        Flex(1, Text("")),
        Fixed(1, TextStyled("  esc back · q quit", DefaultStyle().WithDim())),
    )))

func kvRow(label string, value string) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Fixed(12, TextStyled(label, DefaultStyle().WithDim())),
        Flex(1, TextStyled(value, DefaultStyle())),
    ))

func s2Buttons(m Model) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        btnKeyW("← back", "esc", m.S2Focus == PaneBack(), MBack()),
        Fixed(2, Text("")),
        depsChild(m),
        Flex(1, Text("")),
        btnKeyW("start assimilation", "⏎", m.S2Focus == PaneStart(), MStartRun()),
        Fixed(2, Text("")),
    ))

// depsChild opens the dependency-forest screen (S8). It shows the resolved node
// count once the background resolve has landed, so the user sees there is a forest
// to inspect; mouse-clickable and reachable by 'd' on S2/S3 (the hotkey is on the
// button). Auto-sized so the dynamic count never clips.
func depsChild(m Model) LayoutChild {
    val n = m.Forest match {
        case Some(f) => f.Deps.Length()
        case None()  => 0
    }
    val label = if (n > 0) s"dependencies (${n})" else "dependencies"
    return btnKeyW(label, "d", false, MOpenDeps())
}

// ============================================================================
// S3 — Assimilation dashboard (Variant A, split board)
// ============================================================================

func s3View(m Model) Widget = m.Run match {
    case Some(rs) => s3Board(m, runview.ProjectRun(rs))
    case None()   => Border(TextStyled("  (no run)", DefaultStyle().WithDim()))
}

func s3Board(m Model, rv runview.RunVM) Widget {
    if (rv.Total == 0) { return s3Empty() }
    val board = if (m.Cols >= WideCols()) splitBoard(m, rv) else stackedBoard(m, rv)
    val head = ArrayOf[LayoutChild](
        Fixed(1, headerRow("Assimilation in progress")),
        Fixed(1, breadcrumbRow(rv, m.Frame)),
        Fixed(1, progressBar(rv)),
    ).AppendAll(countsRow(rv, m.Cols))
     .AppendAll(ArrayOf[LayoutChild](Fixed(1, s3Actions(m, rv))))
     .AppendAll(saveErrorRows(m))
    val children = head.AppendAll(ArrayOf[LayoutChild](
        Flex(1, board),
        Fixed(1, s3Footer(m.Cols)),
    ))
    return Border(Column(children))
}

// saveErrorRows surfaces a FAILED checkpoint save on its own full-width line (so the
// reason isn't clipped by the action row) — the operator sees exactly why progress
// couldn't be saved. A clean save shows nothing here (the ✓ indicator suffices).
func saveErrorRows(m Model) Array[LayoutChild] {
    if (!m.Persist || m.LastSaveOk) { return EmptyArray[LayoutChild]() }
    val why = if (m.SaveReason == "") "" else " — " + m.SaveReason
    return ArrayOf[LayoutChild](
        Fixed(1, errLine("⚠ couldn't save checkpoint" + why + " (progress may be lost)",
            DefaultStyle().WithBold().WithFg(BrightYellow()))),
    )
}

// s3Empty guards the degenerate run (no units — e.g. a resumed empty checkpoint):
// a 0/0 board would read as a finished migration, so say plainly there was nothing
// to do rather than show a misleading "complete ✓".
func s3Empty() Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Assimilation — nothing to do")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  This run has no units — nothing was migrated.",
            DefaultStyle().WithBold().WithFg(BrightYellow()))),
        Fixed(1, TextStyled("  Go back and scan a project that has source to translate.",
            DefaultStyle().WithDim())),
        Flex(1, Text("")),
        Fixed(1, TextStyled("  esc back · q quit", DefaultStyle().WithDim())),
    )))

// ----- pipeline-step breadcrumb ---------------------------------------------

// pipelineStages is the migration's five high-level steps, in order. The first
// two are reached before S3 (Scan on S1, Plan on S2); the last three are the
// run's own sub-stages, which runStage derives from live state.
func pipelineStages() Array[string] =
    ArrayOf[string]("Scan", "Plan", "Run", "Verify", "Report")

// stageLabelFor maps a runview stage token to its breadcrumb label. The
// breadcrumb only renders inside a run (S3), so the current step is always one of
// the run sub-stages — Scan/Plan are already behind us and show as completed.
func stageLabelFor(stage string) string {
    if (stage == runview.StageVerify()) { return "Verify" }
    if (stage == runview.StageReport()) { return "Report" }
    return "Run"
}

func stageIndex(stages Array[string], label string) int {
    var i = 0
    val n = stages.Length()
    for i < n {
        if (stages.Get(i) == label) { return i }
        i = i + 1
    }
    return 0
}

// breadcrumbRow renders Scan › Plan › Run › Verify › Report with the current
// stage highlighted, completed stages green-dim, and not-yet-reached stages dim.
func breadcrumbRow(rv runview.RunVM, frame int) Widget {
    val stages = pipelineStages()
    val curIdx = stageIndex(stages, stageLabelFor(rv.Stage))
    var children = ArrayOf[LayoutChild](Fixed(2, Text("")))
    var i = 0
    val n = stages.Length()
    for i < n {
        if (i > 0) {
            children = children.Append(Fixed(3, TextStyled(" › ", DefaultStyle().WithDim())))
        }
        val label = stages.Get(i)
        children = children.Append(
            Fixed(RuneCount(label) + 1, TextStyled(label, stageStyle(i, curIdx))))
        i = i + 1
    }
    val spaced = children.Append(Flex(1, Text("")))
    return Row(spaced.Append(Fixed(14, iteratingIndicator(rv, frame))))
}

// iteratingIndicator surfaces the run-level fix loop: an animated "⠋ iterating…"
// while the loop is still turning (so a working run visibly differs from a hung
// one), flipping to a settled "complete ✓" once the run reaches a fixpoint
// (RunVM.Complete, projected from the engine's IsComplete).
func iteratingIndicator(rv runview.RunVM, frame int) Widget {
    if (rv.Complete) {
        return TextStyled(" complete ✓", DefaultStyle().WithBold().WithFg(BrightGreen()))
    }
    return TextStyled(s" ${spin(frame)} iterating…", DefaultStyle().WithFg(BrightYellow()))
}

func stageStyle(i int, curIdx int) Style {
    if (i == curIdx) { return DefaultStyle().WithBold().WithFg(BrightCyan()) }
    if (i < curIdx)  { return DefaultStyle().WithDim().WithFg(BrightGreen()) }
    return DefaultStyle().WithDim()
}

// s3Actions: open the focused unit + report, a blocker badge when any unit
// awaits a clarification, and the auto-save indicator. Every action is mouse-
// clickable and keyboard-reachable (enter open · p report · badge mirrors blocked).
func s3Actions(m Model, rv runview.RunVM) Widget {
    val badge = if (rv.Counts.Blocked > 0)
        TextStyled(s"[ ! ${rv.Counts.Blocked} blocked → ]",
            DefaultStyle().WithReverse().WithFg(BrightYellow())).OnClick(MOpenBlocker())
    else
        Text("")
    return Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        btnKeyW("open unit", "⏎", false, MOpenUnit()),
        Fixed(2, Text("")),
        btnKeyW("report", "p", false, MOpenReport()),
        Fixed(2, Text("")),
        depsChild(m),
        Flex(1, savedIndicator(m)),
        Fixed(20, badge),
        Fixed(1, Text("")),
    ))
}

func savedIndicator(m Model) Widget {
    if (!m.Persist) { return Text("") }
    if (m.LastSaveOk) {
        return TextStyled("  checkpoint saved ✓", DefaultStyle().WithDim().WithFg(BrightGreen()))
    }
    // The full reason renders on its own row (saveErrorRows); keep this compact.
    return TextStyled("  ⚠ save failed", DefaultStyle().WithBold().WithFg(BrightYellow()))
}

func progressBar(rv runview.RunVM) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Flex(1, Progress(rv.Pct)),
        // Width 20 fits the widest label "  NN/NN units (100%)" without overrunning
        // the right border (18 clipped the trailing ")" at 100%).
        Fixed(20, TextStyled(s"  ${rv.Done}/${rv.Total} units (${rv.Pct}%)",
            DefaultStyle().WithBold().WithFg(BrightGreen()))),
    ))

// countsRow stacks the status tally and the tests counter on the SAME row only when
// the viewport is wide enough; at narrow widths the Flex(1) counts + Fixed(22) tests
// cells collided (rendering "skitests 1/1"), so the tests counter drops to its own
// row below. The caller (s3Board / s6Board) lays this out as one or two Fixed rows.
func countsRow(rv runview.RunVM, cols int) Array[LayoutChild] {
    val c = rv.Counts
    val countsText = TextStyled(
        s"  queued ${c.Queued} · active ${c.Active} · done ${c.Done} · blocked ${c.Blocked} · skipped ${c.Skipped} · failed ${c.Failed}",
        DefaultStyle().WithDim())
    if (cols >= WideCols()) {
        return ArrayOf[LayoutChild](Fixed(1, Row(ArrayOf[LayoutChild](
            Flex(1, countsText),
            Fixed(22, testsCounter(rv)),
        ))))
    }
    return ArrayOf[LayoutChild](
        Fixed(1, countsText),
        Fixed(1, Row(ArrayOf[LayoutChild](Fixed(2, Text("")), Flex(1, testsCounter(rv))))),
    )
}

// testsCounter renders the parity readout (e.g. "tests 7/12 passing"), green and
// bold once every source test passes, cyan while some remain.
func testsCounter(rv runview.RunVM) Widget {
    val allPass = rv.TestsTotal > 0 && rv.TestsPassing >= rv.TestsTotal
    val style = if (allPass)
        DefaultStyle().WithBold().WithFg(BrightGreen())
    else
        DefaultStyle().WithFg(BrightCyan())
    return TextStyled(s"tests ${rv.TestsPassing}/${rv.TestsTotal} passing ", style)
}

func splitBoard(m Model, rv runview.RunVM) Widget =
    Row(ArrayOf[LayoutChild](
        Flex(1, treePane(m, rv)),
        Flex(1, logPane(m, rv)),
    ))

func stackedBoard(m Model, rv runview.RunVM) Widget =
    Column(ArrayOf[LayoutChild](
        Flex(1, treePane(m, rv)),
        Flex(1, logPane(m, rv)),
    ))

// s3Footer shortens below WideCols so the hint never runs off the right border (the
// full line clipped its trailing "Esc back · q quit" at narrow widths).
func s3Footer(cols int) Widget {
    val text = if (cols >= WideCols())
        "  Tab switch pane · ↑/↓ move · ⏎ open unit · p report · d deps · Esc back · q quit"
    else
        "  ⏎ open · p report · d deps · Tab pane · Esc · q"
    return TextStyled(text, DefaultStyle().WithDim())
}

// ----- left: unit tree by package -------------------------------------------

func treePane(m Model, rv runview.RunVM) Widget {
    val focused = m.S3Focus == PaneTree()
    val title = paneTitle("Units", focused, PaneTree())
    val body = Column(treeChildren(m, rv))
    return Border(Column(ArrayOf[LayoutChild](
        Fixed(1, title),
        Flex(1, body),
    )))
}

func treeChildren(m Model, rv runview.RunVM) Array[LayoutChild] {
    var children = EmptyArray[LayoutChild]()
    var prevPkg = ""
    var i = 0
    val n = rv.Rows.Length()
    for i < n {
        val r = rv.Rows.Get(i)
        if (r.Pkg != prevPkg) {
            children = children.Append(Fixed(1,
                TextStyled(" " + r.Pkg + "/", DefaultStyle().WithDim().WithBold())))
            prevPkg = r.Pkg
        }
        children = children.Append(Fixed(1, unitRowWidget(m, r, i)))
        i = i + 1
    }
    return children
}

func unitRowWidget(m Model, r runview.UnitRowVM, idx int) Widget {
    val selected = m.S3Focus == PaneTree() && m.TreeCursor == idx
    val style = if (selected)
        DefaultStyle().WithReverse().WithBold()
    else
        DefaultStyle()
    val row = TextStyled("  " + r.Glyph + " " + r.Id, style).OnClick(MSelectUnit(Idx = idx))
    val badges = rowBadges(r, selected, idx)
    if (badges.IsEmpty()) { return row }
    return Row(ArrayOf[LayoutChild](Flex(1, row)).AppendAll(badges))
}

// rowBadges are the compact right-aligned per-row markers that keep the fix loop
// and correctness flags visible on the unit row: a ×N badge once a unit has retried
// (attempts > 1), a ⚑ flag when its translation raised an unsupported-construct
// flag, and a ⚠ caution when it passed the gate with no 1:1 source-test coverage
// (unverified). A flagged or unverified unit is thus never visually identical to a
// clean pass. Every badge re-targets the same select-unit click as the row.
func rowBadges(r runview.UnitRowVM, selected bool, idx int) Array[LayoutChild] {
    var badges = EmptyArray[LayoutChild]()
    if (r.Attempts > 1) {
        val badgeText = s"×${r.Attempts} "
        badges = badges.Append(Fixed(RuneCount(badgeText),
            TextStyled(badgeText, attemptBadgeStyle(selected)).OnClick(MSelectUnit(Idx = idx))))
    }
    if (r.Flagged) {
        badges = badges.Append(Fixed(2, markerBadge("⚑ ", BrightRed(), selected, idx)))
    }
    if (r.Unverified) {
        badges = badges.Append(Fixed(2, markerBadge("⚠ ", BrightYellow(), selected, idx)))
    }
    return badges
}

func attemptBadgeStyle(selected bool) Style {
    if (selected) { return DefaultStyle().WithReverse().WithBold() }
    return DefaultStyle().WithFg(BrightYellow())
}

// markerBadge is a one-glyph per-row badge (the ⚑ flag / ⚠ unverified markers): the
// glyph in its color, or reverse-bold when the row is selected, re-targeting the
// row's select-unit click. One shape, parameterized by glyph + color.
func markerBadge(glyph string, fg Color, selected bool, idx int) Widget {
    val style = if (selected)
        DefaultStyle().WithReverse().WithBold()
    else
        DefaultStyle().WithFg(fg)
    return TextStyled(glyph, style).OnClick(MSelectUnit(Idx = idx))
}

// ----- right: live activity log ---------------------------------------------

func logPane(m Model, rv runview.RunVM) Widget {
    val focused = m.S3Focus == PaneLog()
    val title = paneTitle("Activity", focused, PaneLog())
    return Border(Column(ArrayOf[LayoutChild](
        Fixed(1, title),
        Flex(1, logColumn(m, rv.Log)),
    )))
}

// logColumn renders a tail window of the log, shifted up by LogScroll.
func logColumn(m Model, lines Array[string]) Widget {
    val avail = maxI(1, m.Rows - 10)
    val total = lines.Length()
    val end = maxI(0, total - m.LogScroll)
    val start = maxI(0, end - avail)
    val window = lines.Slice(start, end)
    return Column(window.Map((ln) => Fixed(1, Text(" " + ln))))
}

// paneTitle is a clickable pane header (mouse focuses the pane; ▸ marks focus).
func paneTitle(label string, focused bool, pane string) Widget {
    val mark = if (focused) "▸ " else "  "
    val style = if (focused)
        DefaultStyle().WithBold().WithFg(BrightCyan())
    else
        DefaultStyle().WithBold()
    return TextStyled(mark + label, style).OnClick(MFocusPane(Pane = pane))
}

// ============================================================================
// S4 — Unit / diff review (Variant 3: diff + agent rationale pane)
// ============================================================================

func s4View(m Model) Widget = m.Run match {
    case Some(rs) => runview.UnitAt(rs, m.TreeCursor) match {
        case Some(vm) => s4Board(m, vm)
        case None()   => Border(TextStyled("  (no unit selected)", DefaultStyle().WithDim()))
    }
    case None() => Border(TextStyled("  (no run)", DefaultStyle().WithDim()))
}

func s4Board(m Model, vm runview.UnitDetailVM) Widget {
    val rationale = if (vm.Rationale == "") "(none)" else vm.Rationale
    val flags = if (vm.Flags.IsEmpty()) "(none)" else joinStrings(vm.Flags, "; ")
    return Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Review — " + vm.Id)),
        Fixed(1, diffLegend()),
        Flex(1, diffArea(m, vm)),
        Fixed(1, diffCaveat(m.Cols)),
        Fixed(1, kvRow("Rationale", rationale)),
        Fixed(1, kvRow("Flags", flags)),
        Fixed(1, kvRow("Verify", vm.Status)),
        Fixed(1, s4ActionBar()),
        Fixed(1, TextStyled("  a accept · r retry · s skip · ↑/↓ scroll · Esc back to dashboard",
            DefaultStyle().WithDim())),
    )))
}

// diffLegend names the per-line tints so the colors are self-explanatory.
func diffLegend() Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Fixed(20, TextStyled("red = source", DefaultStyle().WithFg(BrightRed()))),
        Fixed(20, TextStyled("green = target", DefaultStyle().WithFg(BrightGreen()))),
        Flex(1, TextStyled("dim = unchanged", DefaultStyle().WithDim())),
    ))

// diffCaveat is the honest disclaimer for the cheap by-index comparison: after any
// insertion/deletion the lines no longer align, so "changed" tints can be spurious.
// Surfacing this is the no-silent-drift discipline applied to the UI itself.
func diffCaveat(cols int) Widget {
    val text = if (cols >= WideCols())
        "  ⓘ by-index compare: after an inserted/removed line, later lines may show as changed though they're not."
    else
        "  ⓘ diff is by-index — lines after an edit may look changed."
    return TextStyled(text, DefaultStyle().WithDim().WithFg(BrightYellow()))
}

// diffArea shows source vs emitted target side-by-side (wide) or stacked (narrow),
// each pane line-numbered and scrolled by S4Scroll (↑/↓). Lines that differ at the
// same index are tinted red (source) / green (target); identical lines stay dim.
func diffArea(m Model, vm runview.UnitDetailVM) Widget {
    val tgt = if (vm.HasResult) vm.TargetLines
        else ArrayOf[string](s"${spin(m.Frame)} still translating this unit — no output yet.",
            "", "  This screen will fill in once the agent finishes.")
    val avail = maxI(1, m.Rows - 11)
    val left = diffPane(m, "Source", vm.SourceLines, tgt, true, avail)
    val right = diffPane(m, "Target", tgt, vm.SourceLines, false, avail)
    if (m.Cols >= WideCols()) {
        return Row(ArrayOf[LayoutChild](Flex(1, left), Flex(1, right)))
    }
    return Column(ArrayOf[LayoutChild](Flex(1, left), Flex(1, right)))
}

func diffPane(m Model, title string, lines Array[string], other Array[string], isSource bool, avail int) Widget {
    val total = lines.Length()
    val start = clampInt(m.S4Scroll, 0, maxI(0, total))
    val end = minI(total, start + avail)
    val rows = ArrayTabulate[LayoutChild](maxI(0, end - start), (k int) => {
        val i = start + k
        val ln = lines.Get(i)
        val same = i < other.Length() && other.Get(i) == ln
        val num = lineNo(i + 1)
        return Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(5, TextStyled(num, DefaultStyle().WithDim())),
            Flex(1, TextStyled(ln, diffStyle(isSource, same))),
        )))
    })
    val more = if (end < total) s"  … ${total - end} more lines (↓)" else ""
    val moreRow = if (more == "") Text("") else TextStyled(more, DefaultStyle().WithDim())
    return Border(Column(ArrayOf[LayoutChild](
        Fixed(1, TextStyled(title, DefaultStyle().WithBold().WithFg(BrightCyan()))),
        Flex(1, Column(rows)),
        Fixed(1, moreRow),
    )))
}

// lineNo right-pads a 1-based line number into a 4-wide gutter ("  12 ").
func lineNo(n int) string {
    val s = str.S(intToStr(n))
    val pad = maxI(0, 4 - s.Length())
    return spaces(pad) + s.ToString() + " "
}

func intToStr(n int) string = s"${n}"

func spaces(n int) string {
    var out = ""
    var i = 0
    for i < n { out = out + " "; i = i + 1 }
    return out
}

func diffStyle(isSource bool, same bool) Style {
    if (same) { return DefaultStyle().WithDim() }
    if (isSource) { return DefaultStyle().WithFg(BrightRed()) }
    return DefaultStyle().WithFg(BrightGreen())
}

// s4ActionBar exposes the three real review actions plus a clearly DISABLED "edit"
// (the edit flow is a stub this round) — so it reads as "not available yet", not a
// clickable action that silently does nothing.
func s4ActionBar() Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        btnKeyW("accept", "a", false, MReviewAccept()),
        Fixed(1, Text("")),
        btnKeyW("retry", "r", false, MReviewRetry()),
        Fixed(1, Text("")),
        btnKeyW("skip", "s", false, MReviewSkip()),
        Fixed(1, Text("")),
        Fixed(16, disabledBtn("edit (soon)", false)),
        Flex(1, Text("")),
    ))

// ============================================================================
// S5 — Blocker / clarification
// ============================================================================

func s5View(m Model) Widget = m.Run match {
    case Some(rs) => runview.UnitAt(rs, m.TreeCursor) match {
        case Some(vm) => s5Board(m, vm)
        case None()   => Border(TextStyled("  (no unit selected)", DefaultStyle().WithDim()))
    }
    case None() => Border(TextStyled("  (no run)", DefaultStyle().WithDim()))
}

func s5Board(m Model, vm runview.UnitDetailVM) Widget {
    val question = if (vm.Question == "") "(no question)" else vm.Question
    val head = ArrayOf[LayoutChild](
        Fixed(1, headerRow("Blocker — " + vm.Id)),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  The agent needs a clarification:", DefaultStyle().WithDim())),
        Fixed(1, TextStyled("    " + question, DefaultStyle().WithBold().WithFg(BrightYellow()))),
        Fixed(1, Text("")),
    )
    val snippet = s5SnippetRows(vm)
    val tail = ArrayOf[LayoutChild](
        Fixed(1, TextStyled("  Your answer:", DefaultStyle().WithDim())),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            Flex(1, Input(m.AnswerText, RuneCount(m.AnswerText), "type your answer…", true)),
        ))),
        Fixed(1, Text("")),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            btnKeyW("submit", "⏎", true, MAnswerSubmit()),
            Fixed(2, Text("")),
            // The off-ramp: abandon this unit instead of answering. Mouse-clickable
            // (a letter hotkey would type into the answer field) and Esc-reachable.
            Fixed(19, btnWidget("skip this unit", false, MReviewSkip())),
            Flex(1, Text("")),
        ))),
        Fixed(1, TextStyled("  type your answer · Enter submit · click skip to abandon · Esc cancel",
            DefaultStyle().WithDim())),
    )
    return Border(Column(head.AppendAll(snippet).AppendAll(tail)))
}

// s5SnippetRows shows the first few lines of the unit's source, so the operator can
// answer the clarification with the relevant code in view rather than from memory.
func s5SnippetRows(vm runview.UnitDetailVM) Array[LayoutChild] {
    if (vm.SourceLines.IsEmpty()) { return EmptyArray[LayoutChild]() }
    val shown = minI(vm.SourceLines.Length(), 6)
    val rows = ArrayTabulate[LayoutChild](shown, (i int) =>
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(5, TextStyled(lineNo(i + 1), DefaultStyle().WithDim())),
            Flex(1, TextStyled(vm.SourceLines.Get(i), DefaultStyle().WithDim())),
        ))))
    val more = if (vm.SourceLines.Length() > shown)
        ArrayOf[LayoutChild](Fixed(1, TextStyled(s"     … ${vm.SourceLines.Length() - shown} more lines",
            DefaultStyle().WithDim())))
    else EmptyArray[LayoutChild]()
    return ArrayOf[LayoutChild](
        Fixed(1, TextStyled("  Source:", DefaultStyle().WithDim())),
    ).AppendAll(rows).AppendAll(more).AppendAll(ArrayOf[LayoutChild](Fixed(1, Text(""))))
}

func joinStrings(arr Array[string], sep string) string {
    if (arr.IsEmpty()) { return "" }
    var out = arr.Get(0)
    var i = 1
    val n = arr.Length()
    for i < n {
        out = out + sep + arr.Get(i)
        i = i + 1
    }
    return out
}

// ============================================================================
// S6 — Run report (+ resume affordance)
// ============================================================================

func s6View(m Model) Widget = m.Run match {
    case Some(rs) => s6Board(m, runview.ProjectRun(rs))
    case None()   => Border(TextStyled("  (no run to report)", DefaultStyle().WithDim()))
}

func s6Board(m Model, rv runview.RunVM) Widget {
    val c = rv.Counts
    val problems = c.Failed + c.Blocked
    val allDone = rv.Done >= rv.Total && rv.Total > 0
    // The title must reflect failures — don't claim "complete" when units failed or
    // are still blocked. A clean run that reached 100% is the only "complete".
    val title =
        if (allDone && problems == 0) "Migration report — complete"
        else if (rv.Complete && problems > 0) "Migration report — finished with issues"
        else "Migration report — in progress"
    val children = ArrayOf[LayoutChild](
        Fixed(1, headerRow(title)),
        Fixed(1, Text("")),
        Fixed(1, kvRow("Source", dispPath(m.SourceDir))),
        Fixed(1, kvRow("Progress", s"${rv.Done}/${rv.Total} units (${rv.Pct}%)")),
    ).AppendAll(countsRow(rv, m.Cols))
     .AppendAll(s6IssueRows(c))
     .AppendAll(s6FlagRows(rv))
     .AppendAll(s6OutputRows(m))
     .AppendAll(ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, TextStyled(s"  Checkpoint: ${dispPath(CheckpointPath(m.SourceDir))}", DefaultStyle().WithDim())),
        Fixed(1, Text("")),
        Fixed(1, s6Actions(m, rv, problems)),
        Flex(1, Text("")),
        Fixed(1, s6Footer(rv, problems)),
    ))
    return Border(Column(children))
}

// s6IssueRows foregrounds the failures/blocked counts and points the user at them
// (S3's tree, via back) — so a report with problems never reads as a clean success.
func s6IssueRows(c runview.StatusCounts) Array[LayoutChild] {
    if (c.Failed == 0 && c.Blocked == 0) { return EmptyArray[LayoutChild]() }
    return ArrayOf[LayoutChild](
        Fixed(1, Text("")),
        Fixed(1, TextStyled(
            s"  ⚠ ${c.Failed} failed · ${c.Blocked} blocked — review them on the dashboard (Esc).",
            DefaultStyle().WithBold().WithFg(BrightYellow()))),
    )
}

// s6FlagRows foregrounds the correctness markers — flagged (unsupported-construct)
// and unverified (no 1:1 source-test coverage) units — counted from the run rows, so
// a report that "completed" but left questionable translations behind says so, and
// points the operator at the dashboard to review them.
func s6FlagRows(rv runview.RunVM) Array[LayoutChild] {
    val flagged    = rv.Rows.Count((r runview.UnitRowVM) => r.Flagged)
    val unverified = rv.Rows.Count((r runview.UnitRowVM) => r.Unverified)
    if (flagged == 0 && unverified == 0) { return EmptyArray[LayoutChild]() }
    return ArrayOf[LayoutChild](
        Fixed(1, TextStyled(
            s"  ⚑ ${flagged} flagged · ⚠ ${unverified} unverified — open them on the dashboard (Esc) to check.",
            DefaultStyle().WithFg(BrightYellow()))),
    )
}

// s6OutputRows surfaces WHERE the migrated project was written once integration has
// run (or the failure reason) — the whole point of the run is the emitted output.
func s6OutputRows(m Model) Array[LayoutChild] = m.Integrated match {
    case Some(sum) => {
        if (sum.Ok) {
            return ArrayOf[LayoutChild](
                Fixed(1, Text("")),
                Fixed(1, TextStyled(s"  ✓ Results written to ${dispPath(OutputDir(m.SourceDir))}  (${sum.Files} files)",
                    DefaultStyle().WithBold().WithFg(BrightGreen()))))
        }
        return ArrayOf[LayoutChild](
            Fixed(1, Text("")),
            Fixed(1, TextStyled(s"  ✗ Couldn't write output: ${sum.Reason}",
                DefaultStyle().WithBold().WithFg(BrightRed()))))
    }
    case None() => EmptyArray[LayoutChild]()
}

// s6Actions chooses the context-appropriate primary action. With problems, route
// the operator back to review them; on a clean complete run there is nothing to
// resume, so offer "done"; otherwise (genuinely partial) offer resume-from-disk.
func s6Actions(m Model, rv runview.RunVM, problems int) Widget {
    if (problems > 0) {
        return Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            btnKeyW("review on dashboard", "esc", true, MBack()),
        ))
    }
    if (rv.Done >= rv.Total && rv.Total > 0) {
        return Row(ArrayOf[LayoutChild](
            Fixed(2, Text("")),
            btnKeyW("done", "esc", true, MBack()),
        ))
    }
    return Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        btnKeyW("resume from checkpoint", "r", true, MResumeFromDisk()),
    ))
}

func s6Footer(rv runview.RunVM, problems int) Widget {
    if (problems > 0) {
        return TextStyled("  Esc review on dashboard · q quit", DefaultStyle().WithDim())
    }
    if (rv.Done >= rv.Total && rv.Total > 0) {
        return TextStyled("  Esc back · q quit", DefaultStyle().WithDim())
    }
    return TextStyled("  r resume from checkpoint · Esc back · q quit", DefaultStyle().WithDim())
}

// ============================================================================
// S7 — Directory browser (the source-project picker)
//
// A scrollable list of the current directory's sub-directories (".." first), each
// flagged when it looks like a project root. Cursor + actions are both mouse- and
// keyboard-reachable: click a row to highlight, the buttons / keys open (descend),
// select (commit), or cancel. The header always shows the folder being listed so
// "select" is unambiguous.
// ============================================================================

func s7View(m Model) Widget = m.Browse match {
    case Some(b) => s7Board(m, b)
    case None()  => Border(TextStyled("  (no directory)", DefaultStyle().WithDim()))
}

func s7Board(m Model, b BrowseState) Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Choose source project")),
        Fixed(1, kvRow("Folder", b.Dir)),
        Fixed(1, Text("")),
        Flex(1, browseList(m, b)),
        Fixed(1, Text("")),
        Fixed(1, s7Buttons()),
        Fixed(1, TextStyled("  ↑/↓ move · ← parent dir · ⏎ open · s select · Esc cancel",
            DefaultStyle().WithDim())),
    )))

// browseList renders a window of the entries around the cursor (so a deep
// directory still scrolls), or a loading / empty notice.
func browseList(m Model, b BrowseState) Widget {
    val total = b.Entries.Length()
    if (total == 0) {
        val msg = if (b.Loading) s"  ${spin(m.Frame)} reading directory…" else "  (no sub-directories here)"
        return Column(ArrayOf[LayoutChild](Fixed(1, TextStyled(msg, DefaultStyle().WithDim()))))
    }
    val avail = maxI(1, m.Rows - 9)
    val start = browseWindowStart(b.Cursor, avail, total)
    val end = minI(total, start + avail)
    val rows = ArrayTabulate[LayoutChild](end - start, (k int) => {
        val idx = start + k
        return Fixed(1, browseRow(b, idx))
    })
    return Column(rows)
}

// browseWindowStart keeps the cursor inside the visible window, clamped so the
// last page doesn't scroll past the end.
func browseWindowStart(cursor int, avail int, total int) int {
    if (total <= avail) { return 0 }
    val s = cursor - avail / 2
    if (s < 0) { return 0 }
    val maxStart = total - avail
    if (s > maxStart) { return maxStart }
    return s
}

func browseRow(b BrowseState, idx int) Widget {
    val e = b.Entries.Get(idx)
    val selected = idx == b.Cursor
    val caret = if (selected) "▸ " else "  "
    val name = if (e.IsParent) ".." else e.Name + "/"
    val marker = if (e.Marker == "") "" else "   (" + e.Marker + ")"
    val text = "  " + caret + name + marker
    val style = browseRowStyle(selected, e.Marker != "")
    // Single click highlights the row; double click descends into it (the clicked
    // index, not the stale cursor — the highlighting single-click is suppressed
    // when the double fires).
    return TextStyled(text, style)
        .OnClick(MBrowseClick(Idx = idx))
        .OnDoubleClick(MBrowseOpenAt(Idx = idx))
}

func browseRowStyle(selected bool, isProject bool) Style {
    if (selected) { return DefaultStyle().WithReverse().WithBold() }
    if (isProject) { return DefaultStyle().WithFg(BrightGreen()) }
    return DefaultStyle()
}

func s7Buttons() Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        btnKeyW("open", "⏎", false, MBrowseOpen()),
        Fixed(2, Text("")),
        btnKeyW("select", "s", false, MBrowseSelect()),
        Fixed(2, Text("")),
        btnKeyW("cancel", "esc", false, MBack()),
        Flex(1, Text("")),
    ))

// ============================================================================
// S8 — Dependency forest (tracking + resolution)
//
// The resolved DependencyForest as a trackable TREE: each dependency indented by
// its transitive depth, with a status glyph/label, its own clone folder, and — for
// an in-flight sub-run — its assimilation progress. The two surfaced off-ramps
// (unsupported / failed) render in a distinct color so the product invariant stays
// visible. A selection cursor walks the tree; the four operator actions (resolve /
// skip / retry / expand) are reachable by both mouse (per-node buttons) and key
// (o/s/r/x), each gated by the node's projected availability.
// ============================================================================

func s8View(m Model) Widget = m.Forest match {
    case Some(f) => s8Board(m, runview.ProjectForest(f))
    case None()  => s8Empty(m)
}

// s8Empty is shown while the background ResolveDeps is still in flight (the screen
// was opened before the forest landed) — with an animated spinner so it reads as
// working, not hung.
func s8Empty(m Model) Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Dependencies")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled(s"  ${spin(m.Frame)} Resolving dependencies…", DefaultStyle().WithDim())),
        Flex(1, Text("")),
        Fixed(1, TextStyled("  esc back · q quit", DefaultStyle().WithDim())),
    )))

func s8Board(m Model, fv runview.ForestVM) Widget {
    if (fv.Total == 0) { return s8NoDeps() }
    return Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Dependencies")),
        Fixed(1, depsSummaryRow(fv, m.Frame)),
        Fixed(1, depsProgressRow(fv)),
        Fixed(1, Text("")),
        Flex(1, depsTree(m, fv)),
        Fixed(1, s8CursorRow(m, fv)),
        Fixed(1, s8Actions(m, fv)),
        Fixed(1, s8Footer()),
    )))
}

// s8CursorRow echoes the cursored node above the action bar ("Actions for <node>:"),
// so it is unambiguous which dependency the buttons / keys will act on.
func s8CursorRow(m Model, fv runview.ForestVM) Widget {
    val idx = clampInt(m.DepCursor, 0, maxI(0, fv.Rows.Length() - 1))
    val r = fv.Rows.Get(idx)
    return TextStyled(s"  Actions for ${r.Module} ${r.Version}  [${r.Status}]:",
        DefaultStyle().WithBold().WithFg(BrightCyan()))
}

// s8NoDeps is the honest "scanned, no external dependencies" state — distinct from
// the still-resolving notice so the user isn't left waiting on a forest that is empty.
func s8NoDeps() Widget =
    Border(Column(ArrayOf[LayoutChild](
        Fixed(1, headerRow("Dependencies — none")),
        Fixed(1, Text("")),
        Fixed(1, TextStyled("  This project declares no external dependencies to assimilate.",
            DefaultStyle().WithDim())),
        Flex(1, Text("")),
        Fixed(1, TextStyled("  esc back · q quit", DefaultStyle().WithDim())),
    )))

func depsSummaryRow(fv runview.ForestVM, frame int) Widget =
    Row(ArrayOf[LayoutChild](
        Flex(1, TextStyled(
            s"  ${fv.Done}/${fv.Total} deps done · unsupported ${fv.Unsupported} · failed ${fv.Failed}",
            DefaultStyle().WithDim())),
        Fixed(15, iteratingDeps(fv, frame)),
    ))

// iteratingDeps mirrors the run's loop indicator: an animated "⠋ resolving…" while
// any node is still drivable (so a working forest visibly differs from a hung one),
// flipping to "complete ✓" once the forest reaches its fixpoint.
func iteratingDeps(fv runview.ForestVM, frame int) Widget {
    if (fv.Complete) {
        return TextStyled(" complete ✓", DefaultStyle().WithBold().WithFg(BrightGreen()))
    }
    return TextStyled(s" ${spin(frame)} resolving…", DefaultStyle().WithFg(BrightYellow()))
}

func depsProgressRow(fv runview.ForestVM) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        Flex(1, Progress(fv.Pct)),
        Fixed(16, TextStyled(s"  ${fv.Done}/${fv.Total} (${fv.Pct}%)",
            DefaultStyle().WithBold().WithFg(BrightGreen()))),
    ))

// depsTree renders a window of forest rows around the cursor (so a deep forest still
// scrolls), each indented by its transitive depth.
func depsTree(m Model, fv runview.ForestVM) Widget {
    val total = fv.Rows.Length()
    val avail = maxI(1, m.Rows - 9)
    val start = browseWindowStart(m.DepCursor, avail, total)
    val end = minI(total, start + avail)
    val rows = ArrayTabulate[LayoutChild](end - start, (k int) => {
        val idx = start + k
        return Fixed(1, depRowWidget(m, fv.Rows.Get(idx), idx))
    })
    return Column(rows)
}

func depRowWidget(m Model, r runview.DepRowVM, idx int) Widget {
    val selected = m.DepCursor == idx
    val coord = r.Module + " " + r.Version
    val prog = if (r.Status == "assimilating")
        s"  ${r.UnitsDone}/${r.UnitsTotal} (${r.Pct}%)"
    else
        ""
    val text = depIndent(r.Depth) + r.Glyph + " " + coord + "  [" + r.Status + "]" + prog + depReasonSuffix(r)
    return TextStyled(text, depRowStyle(r, selected)).OnClick(MDepSelect(Idx = idx))
}

// depIndent is the transitive-depth indentation: two spaces per level (root deps at
// depth 1 → one level), so the reconstructed tree reads at a glance.
func depIndent(depth int) string {
    var s = "  "
    var i = 1
    for i < depth {
        s = s + "  "
        i = i + 1
    }
    return s
}

// depReasonSuffix appends the surfaced reason for the off-ramp states, collapsed to
// one capped line so a long clone/verify diagnostic stays readable.
func depReasonSuffix(r runview.DepRowVM) string {
    if (r.Reason == "") { return "" }
    return "  — " + trimDepReason(r.Reason)
}

func trimDepReason(reason string) string {
    val oneLine = str.S(reason).ReplaceAll("\n", " ").Trim()
    if (oneLine.Length() <= 44) { return oneLine.ToString() }
    // Cut on a word boundary so the truncation never lands mid-word ("expand t…").
    // Accumulate whole words up to the cap, then ellipsize; a single over-long first
    // word still falls back to a hard cut so something always shows.
    val words = oneLine.Split(" ")
    var out = ""
    var stop = false
    var i = 0
    val n = words.Length()
    for i < n {
        if (!stop) {
            val w = words.Get(i).ToString()
            val next = if (out == "") w else out + " " + w
            if (RuneCount(next) > 44) { stop = true } else { out = next }
        }
        i = i + 1
    }
    if (out == "") { return oneLine.Take(44).ToString() + "…" }
    return out + "…"
}

// depRowStyle keeps the off-ramps VISUALLY DISTINCT: failed in red, unsupported in
// bold yellow, skipped dim, done green, an in-flight node cyan — and the selected row
// reverse-bold over all of it.
func depRowStyle(r runview.DepRowVM, selected bool) Style {
    if (selected)         { return DefaultStyle().WithReverse().WithBold() }
    if (r.IsFailed)       { return DefaultStyle().WithBold().WithFg(BrightRed()) }
    if (r.IsUnsupported)  { return DefaultStyle().WithBold().WithFg(BrightYellow()) }
    if (r.IsSkipped)      { return DefaultStyle().WithDim() }
    if (r.IsDone)         { return DefaultStyle().WithFg(BrightGreen()) }
    return DefaultStyle().WithFg(BrightCyan())
}

// s8Actions is the per-node action bar for the cursored dependency: each of the four
// operator actions, enabled (clickable) only when the projection says it is meaningful
// on this node's status — so an action is never silently a no-op.
func s8Actions(m Model, fv runview.ForestVM) Widget {
    val idx = clampInt(m.DepCursor, 0, maxI(0, fv.Rows.Length() - 1))
    val row = fv.Rows.Get(idx)
    return Row(ArrayOf[LayoutChild](
        Fixed(2, Text("")),
        depActionChild("resolve", "o", row.CanResolve, MDepResolve()),
        Fixed(1, Text("")),
        depActionChild("skip", "s", row.CanSkip, MDepSkip()),
        Fixed(1, Text("")),
        depActionChild("retry", "r", row.CanRetry, MDepRetry()),
        Fixed(1, Text("")),
        depActionChild("expand", "x", row.CanExpand, MDepExpand()),
        Flex(1, depsSavedIndicator(m)),
    ))
}

// depActionChild renders an enabled (clickable) action button with its hotkey, or a
// clearly INERT disabled control when the action does not apply to the cursored node.
// The disabled form uses parenthesis brackets + a dim strike-through dash and no
// click contract — visibly different from the actionable square-bracket buttons, so
// an unavailable action never looks clickable. Auto-sized so labels never clip.
func depActionChild(label string, keyHint string, enabled bool, msg Msg) LayoutChild {
    if (enabled) {
        val w = RuneCount(label) + RuneCount(keyHint) + 6
        return Fixed(w, btnKey(label, keyHint, false, msg))
    }
    // Inert form: a ⊘ prefix + parenthesis brackets + no click contract, so it reads
    // as "not available", visibly distinct from the clickable [ … ] buttons.
    val txt = "(⊘ " + label + "  " + keyHint + " )"
    return Fixed(RuneCount(label) + RuneCount(keyHint) + 8, TextStyled(txt, DefaultStyle().WithDim()))
}

func depsSavedIndicator(m Model) Widget {
    if (!m.Persist) { return Text("") }
    if (m.ForestSaveOk) {
        return TextStyled("  forest saved ✓", DefaultStyle().WithDim().WithFg(BrightGreen()))
    }
    return TextStyled("  forest save failed ✗", DefaultStyle().WithFg(BrightYellow()))
}

func s8Footer() Widget =
    TextStyled("  ↑/↓ move · o resolve · s skip · r retry · x expand · Esc back · q quit",
        DefaultStyle().WithDim())

// ============================================================================
// Shared control primitives
// ============================================================================

func btnWidget(label string, focused bool, msg Msg) Widget {
    val txt = "[ " + label + " ]"
    val style = if (focused)
        DefaultStyle().WithReverse().WithBold()
    else
        DefaultStyle().WithBold().WithFg(BrightGreen())
    return TextStyled(txt, style).OnClick(msg)
}

// btnKey is btnWidget with the action's keyboard shortcut shown after the label —
// e.g. "[ report  p ]" — so every action is operable (and discoverable) by
// keyboard, not just mouse. Use the visible key the update loop listens for
// ("p", "d", "⏎", "esc", "s", …).
func btnKey(label string, keyHint string, focused bool, msg Msg) Widget =
    btnWidget(label + "  " + keyHint, focused, msg)

// btnKeyW is btnKey wrapped in a Fixed cell sized to the rendered text, so callers
// don't hand-tune column widths when a hotkey is appended. Width = "[ " + label +
// "  " + key + " ]".
func btnKeyW(label string, keyHint string, focused bool, msg Msg) LayoutChild =
    Fixed(RuneCount(label) + RuneCount(keyHint) + 6, btnKey(label, keyHint, focused, msg))

func cyclerWidget(value string, focused bool, msg Msg) Widget {
    val txt = "‹ " + value + " ›"
    val style = if (focused)
        DefaultStyle().WithReverse().WithBold()
    else
        DefaultStyle().WithFg(BrightCyan())
    return TextStyled(txt, style).OnClick(msg)
}

func stepperWidget(value int, focused bool) Widget {
    val arrow = DefaultStyle().WithBold().WithFg(BrightCyan())
    val valStyle = if (focused)
        DefaultStyle().WithReverse().WithBold()
    else
        DefaultStyle().WithBold()
    return Row(ArrayOf[LayoutChild](
        Fixed(2, TextStyled("‹ ", arrow).OnClick(MStepRetry(Dir = -1))),
        Fixed(3, TextStyled(s" ${value} ", valStyle)),
        Fixed(2, TextStyled(" ›", arrow).OnClick(MStepRetry(Dir = 1))),
    ))
}

func radioCell(selected bool, groupFocused bool, label string, msg Msg) LayoutChild {
    val mark = if (selected) "(•) " else "( ) "
    val base = DefaultStyle()
    val style = if (groupFocused && selected)
        base.WithReverse().WithBold()
    else if (selected)
        base.WithBold().WithFg(BrightCyan())
    else
        base.WithDim()
    val w = RuneCount(mark + label) + 2
    return Fixed(w, TextStyled(mark + label, style).OnClick(msg))
}

func resizeNotice(m Model) Widget {
    val msg = s"Resize to ≥ ${MinCols()}×${MinRows()}"
    val body = Column(ArrayOf[LayoutChild](
        Fixed(1, TextStyled(msg, DefaultStyle().WithBold().WithFg(BrightYellow()))),
        Fixed(1, TextStyled("(terminal too small)", DefaultStyle().WithDim())),
    ))
    return body.Centered(m.Cols, m.Rows)
}
