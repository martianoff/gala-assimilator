package ui

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-assimilator/app/engine"
    "martianoff/gala/fs"
    "martianoff/gala/path"
)

// ============================================================================
// Checkpoint paths + the save effect.
//
// The checkpoint lives at a stable per-project location: <source-root>/
// .assimilator/state.json. The UI never blocks on IO — saving is wrapped in an
// Async Cmd (saveCmd) the runtime drains; doSave is the pure-ish effect it runs
// (ensure the dir, then SaveCheckpoint through the engine port).
// ============================================================================

// CheckpointDir is the per-project state directory.
func CheckpointDir(root string) string = path.Join(root, ".assimilator")

// CheckpointPath is the stable per-project checkpoint file.
func CheckpointPath(root string) string = path.Join(CheckpointDir(root), "state.json")

// OutputDir is where the migrated project is written once a run completes —
// a stable per-project location beside the checkpoint (<root>/.assimilator/out)
// so the user always knows where to find the translated sources.
func OutputDir(root string) string = path.Join(CheckpointDir(root), "out")

// ForestCheckpointPath is the stable per-project DEPENDENCY-FOREST checkpoint, the
// forest-scoped sibling of CheckpointPath. A transitive multi-dependency migration
// is exactly the run that must survive quit/crash without re-cloning finished deps,
// so the forest persists alongside the run state.
func ForestCheckpointPath(root string) string = path.Join(CheckpointDir(root), "forest.json")

// doSave ensures the state dir exists, then persists the run via the port.
// Returns the port's SaveResult (Ok=false carrying the reason on any IO failure —
// never throws), so the UI can surface exactly WHY a save failed.
func doSave(port engine.EnginePort, state engine.RunState, root string) engine.SaveResult {
    fs.MkdirAll(CheckpointDir(root), 493)   // 0755; ignore result — SaveCheckpoint reports failure
    return port.SaveCheckpoint(state, CheckpointPath(root))
}

// saveCmd persists the run off the Update loop; the result surfaces as
// MCheckpointSaved so the UI can show a save indicator (and the failure reason). On
// a successful save it ALSO records the project in the user-level recent-projects
// index (best-effort), so a later launch can offer to resume THIS project — not just
// one hardcoded default path.
func saveCmd(port engine.EnginePort, state engine.RunState, root string) Cmd[Msg] =
    Async[engine.SaveResult, Msg](
        () => saveAndRecord(port, state, root),
        (res) => MCheckpointSaved(Ok = res.Ok, Reason = res.Reason),
    )

// saveAndRecord persists the checkpoint and, on success, upserts the recent-projects
// index entry for this root with the latest progress. The recent write is best-effort
// — it never changes the save's own success/failure.
func saveAndRecord(port engine.EnginePort, state engine.RunState, root string) engine.SaveResult {
    val res = doSave(port, state, root)
    if (res.Ok) {
        engine.RecordRecent(root, engine.CountByDone(state), state.Units.Length(), engine.NowMillis())
    }
    return res
}

// loadCmd reads the checkpoint off the loop; the result surfaces as
// MResumeLoaded (used by the S6 resume affordance).
func loadCmd(port engine.EnginePort, root string) Cmd[Msg] =
    Async[engine.CheckpointLoad, Msg](
        () => port.LoadCheckpoint(CheckpointPath(root)),
        (load) => MResumeLoaded(Load = load),
    )

// doIntegrate writes the completed migration to <root>/.assimilator/out via the
// engine port, returning the IntegrateResult (file list or failure reason). The
// output root is created as part of the engine's emit (writeOne mkdir's parents).
func doIntegrate(port engine.EnginePort, state engine.RunState, model engine.WorkspaceModel, root string) engine.IntegrateResult =
    port.Integrate(state, model, OutputDir(root))

// integrateCmd writes the migrated project off the Update loop once a run is
// complete; the result surfaces as MIntegrated so the UI can show WHERE the output
// landed (or the failure reason).
func integrateCmd(port engine.EnginePort, state engine.RunState, model engine.WorkspaceModel, root string) Cmd[Msg] =
    Async[engine.IntegrateResult, Msg](
        () => doIntegrate(port, state, model, root),
        (res) => MIntegrated(Result = res),
    )

// projectEvalCmd runs the WHOLE-PROJECT gate (compile + test the integrated migration)
// off the Update loop — it spawns the real target toolchain, which can take seconds,
// so it must never run inline. The verdict surfaces as MProjectEvaluated, which decides
// whether to integrate or to feed the diagnostics back into the loop.
func projectEvalCmd(port engine.EnginePort, state engine.RunState, model engine.WorkspaceModel) Cmd[Msg] =
    Async[engine.ProjectEvaluation, Msg](
        () => port.EvaluateProject(state, model),
        (eval) => MProjectEvaluated(Eval = eval),
    )

// doSaveProbe verifies the checkpoint location is WRITABLE before a run starts:
// it creates <root>/.assimilator and writes-then-removes a tiny probe file. It
// returns an empty string on success, or a plain-language reason on failure — so a
// run that could never be saved is stopped up front rather than after lost work.
func doSaveProbe(root string) string {
    val dir = CheckpointDir(root)
    val mk = fs.MkdirAll(dir, 493)
    if mk.IsFailure() { return "couldn't create the folder (" + mk.Err.Error() + ")" }
    val probe = path.Join(dir, ".write-probe")
    val wr = fs.WriteFileString(probe, "ok", 420)
    if wr.IsFailure() { return "the folder isn't writable (" + wr.Err.Error() + ")" }
    fs.RemoveAll(probe)
    return ""
}

// saveProbeCmd runs the pre-flight writability check off the Update loop; the
// result surfaces as MSavePreflight.
func saveProbeCmd(root string) Cmd[Msg] =
    Async[string, Msg](
        () => doSaveProbe(root),
        (reason) => MSavePreflight(Reason = reason),
    )

// doSaveForest ensures the state dir exists, persists the forest via the port, AND
// writes a human-readable dependency diagnostics log (deps.log) beside it — the FULL
// per-dependency reasons (the exact failing git command + stderr, the no-mapping
// note), which the dependency screen can only show truncated. Best-effort: the log
// write never changes the checkpoint's own success.
func doSaveForest(port engine.EnginePort, forest engine.DependencyForest, root string) bool {
    fs.MkdirAll(CheckpointDir(root), 493)   // 0755; ignore result — SaveForest reports failure
    fs.WriteFileString(DepsLogPath(root), engine.ForestReport(forest), 420)
    return port.SaveForest(forest, ForestCheckpointPath(root))
}

// DepsLogPath / SessionLogPath are the human-readable diagnostics logs beside the
// checkpoint: deps.log captures the dependency resolution (full reasons), session.log
// captures the run + the whole-project compile/test evaluation.
func DepsLogPath(root string) string = path.Join(CheckpointDir(root), "deps.log")
func SessionLogPath(root string) string = path.Join(CheckpointDir(root), "session.log")

// writeSessionLog records the finished run + its project-gate evaluation to
// session.log (best-effort, off the loop). It is how a completed migration leaves a
// readable record of HOW it was verified — compile/test verdicts and diagnostics.
func writeSessionLog(backend string, state engine.RunState, eval engine.ProjectEvaluation, attempts int, root string) bool {
    fs.MkdirAll(CheckpointDir(root), 493)
    val body = engine.SmokeReport(backend, state) + "\n\n" + engine.EvaluationReport(eval, attempts)
    return !fs.WriteFileString(SessionLogPath(root), body, 420).IsFailure()
}

func sessionLogCmd(backend string, state engine.RunState, eval engine.ProjectEvaluation, attempts int, root string) Cmd[Msg] =
    Async[bool, Msg](
        () => writeSessionLog(backend, state, eval, attempts, root),
        (_) => MNoOp(),
    )

// saveForestCmd persists the dependency forest off the Update loop; the result
// surfaces as MForestSaved so the UI can show a save indicator.
func saveForestCmd(port engine.EnginePort, forest engine.DependencyForest, root string) Cmd[Msg] =
    Async[bool, Msg](
        () => doSaveForest(port, forest, root),
        (ok) => MForestSaved(Ok = ok),
    )

// loadForestCmd reads the forest checkpoint off the loop; the result surfaces as
// MForestLoaded (resumed alongside the run checkpoint).
func loadForestCmd(port engine.EnginePort, root string) Cmd[Msg] =
    Async[engine.ForestLoad, Msg](
        () => port.LoadForest(ForestCheckpointPath(root)),
        (load) => MForestLoaded(Load = load),
    )
