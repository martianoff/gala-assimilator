package ui

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-assimilator/app/engine"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Backend → engine factory. Claude is the only user-facing backend, so a scan
// always hands "claude" to engine.SelectBackend. A recording factory captures
// that name (and returns the offline MockEngine, so gala test never touches the
// live backend), proving the run is wired through the port.
// ============================================================================

// The default (and only) backend is Claude; on scan, "claude" flows to the factory.
func TestDefaultBackendFlowsToFactory(t T) T {
    var captured = ""
    val factory = (name string) => {
        captured = name
        return engine.MockEngine()
    }
    val (_, _) = StepAll(NewProgram(factory, 110, 30), ArrayOf[Msg](MScanRequested()))
    return Eq(t, captured, "claude")
}

// The selected port is installed on the model and drives the rest of the run:
// after a scan with the recording factory, Model.Port is the returned engine and
// Scanning is set (the Async Scan→Plan Cmd was issued).
func TestSelectedPortInstalledAndScanning(t T) T {
    val factory = (name string) => engine.MockEngine()
    val (m1, cmds) = StepAll(NewProgram(factory, 110, 30), ArrayOf[Msg](MScanRequested()))
    val t1 = IsTrue(t, m1.Scanning)
    return IsTrue(t1, cmds.NonEmpty())
}
