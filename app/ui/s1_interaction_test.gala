package ui

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-assimilator/app/engine"
    "github.com/martianoff/gala-tui/harness"
    str "martianoff/gala/strings"
    . "martianoff/gala/test"
)

// ============================================================================
// Interaction tests through the gala_tui full (mouse-aware) harness.
//
// One keyboard path and one mouse path, asserting the resulting Model + View
// transition — proving the mouse/keyboard parity rule on a concrete action.
// ============================================================================

func s1Harness() harness.Harness[Model, Msg] {
    val program = NewProgram(mockFactory(), 110, 20)
    return harness.NewHarnessFull[Model, Msg](program, (e) => inputToMsg(e), 110, 20)
}

// Keyboard: Tab through the (local-origin) source controls to the target-language
// cycler (browse → origin → target — the URL/ref stops only exist in the GitHub ring),
// then ArrowRight cycles it forward.
func TestKeyboardCyclesTargetLanguage(t T) T {
    val s = s1Harness().Start()
        .Press(PlainKey(Tab()))         // browse → origin
        .Press(PlainKey(Tab()))         // origin → target
        .Press(PlainKey(ArrowRight()))  // cycle target forward
    val t1 = Eq(t, s.Model.TargetLang(), "TypeScript")
    // View reflects the new selection.
    val out = str.S(Snapshot(view(s.Model), 110, 20))
    return IsTrue(t1, out.Contains("‹ TypeScript ›"))
}

// Mouse: clicking the "skip" radio selects the Skip policy (no keyboard used).
func TestMouseSelectsSkipPolicy(t T) T {
    val s0 = s1Harness().Start()
    // Default policy is flag & continue.
    val pre = IsTrue(t, UnsupportedEq(s0.Model.Unsupported, FlagContinue()))
    val rowOpt = s0.FindRow("skip")
    return rowOpt match {
        case Some(y) => {
            val rowText = str.S(s0.Text()).Lines().Get(y)
            val colOpt = rowText.IndexOf("skip")
            return colOpt match {
                case Some(x) => {
                    val s1 = s0.Click(x + 1, y)
                    val t1 = IsTrue(pre, UnsupportedEq(s1.Model.Unsupported, SkipUnit()))
                    // The view now marks skip selected.
                    val out = str.S(Snapshot(view(s1.Model), 110, 20))
                    return IsTrue(t1, out.Contains("(•) skip"))
                }
                case None() => IsTrue(pre, false)
            }
        }
        case None() => IsTrue(pre, false)
    }
}

// Mouse parity for the GitHub origin: clicking the "GitHub URL" radio then clicking
// INSIDE the URL box focuses the box, and typing a URL that contains 'q' edits the
// field — proving the click is no longer a no-op and 'q' types instead of quitting
// the app (the reported "impossible to input a repo" trap).
func TestMouseClickUrlBoxFocusesAndTypes(t T) T {
    val s0 = s1Harness().Start()
    return s0.FindRow("GitHub URL") match {
        case Some(y) => {
            val rowText = str.S(s0.Text()).Lines().Get(y)
            return rowText.IndexOf("GitHub URL") match {
                case Some(x) => {
                    val s1 = s0.Click(x + 1, y)
                    val t1 = IsTrue(t, s1.Model.OriginGit)
                    // Click inside the URL input box (its placeholder), then type.
                    return s1.FindRow("owner/repo") match {
                        case Some(by) => {
                            val boxText = str.S(s1.Text()).Lines().Get(by)
                            return boxText.IndexOf("owner/repo") match {
                                case Some(bx) => {
                                    val s2 = s1.Click(bx + 1, by)
                                    val t2 = Eq(t1, s2.Model.Focus.Current(), PaneUrl())
                                    val s3 = s2.Press(PlainKey(Char('q')))
                                                .Press(PlainKey(Char('/')))
                                                .Press(PlainKey(Char('x')))
                                    return Eq(t2, s3.Model.RepoUrl, "q/x")
                                }
                                case None() => IsTrue(t1, false)
                            }
                        }
                        case None() => IsTrue(t1, false)
                    }
                }
                case None() => IsTrue(t, false)
            }
        }
        case None() => IsTrue(t, false)
    }
}

// Mouse: clicking the scan button starts the scan and enters the scanning state.
func TestMouseClickScanStartsScan(t T) T {
    val s0 = s1Harness().Start()
    val rowOpt = s0.FindRow("scan project")
    return rowOpt match {
        case Some(y) => {
            val rowText = str.S(s0.Text()).Lines().Get(y)
            val colOpt = rowText.IndexOf("scan project")
            return colOpt match {
                case Some(x) => {
                    val s1 = s0.Click(x + 1, y)
                    return IsTrue(t, s1.Model.Scanning)
                }
                case None() => IsTrue(t, false)
            }
        }
        case None() => IsTrue(t, false)
    }
}
