package ui

import (
    "github.com/martianoff/gala-assimilator/app/engine"
    "github.com/martianoff/gala-assimilator/app/runview"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
)

// ============================================================================
// Model — the single immutable app state.
//
// Routing is a ScreenStack of route tokens: S1 (interview) → S2 (plan summary)
// → S3 (assimilation dashboard). The engine is consumed ONLY through its public
// port (engine.EnginePort); the live run is carried as plain engine value types
// (WorkspaceModel / MigrationPlan / RunState) — no engine internals.
//
// S1 keyboard focus is a FocusRing; S2/S3 each track their own small focus +
// cursor/scroll state so mouse and keyboard reach the same actions everywhere.
// ============================================================================

// Route tokens for the ScreenStack.
func RouteS0() string = "S0"   // Resume / corrupt-checkpoint launch prompt
func RouteS1() string = "S1"   // Setup / Interview
func RouteS2() string = "S2"   // Plan summary
func RouteS3() string = "S3"   // Assimilation dashboard
func RouteS4() string = "S4"   // Unit / diff review
func RouteS5() string = "S5"   // Blocker / clarification
func RouteS6() string = "S6"   // Run report (+ resume affordance)
func RouteS7() string = "S7"   // Directory browser (source-project picker)
func RouteS8() string = "S8"   // Dependency forest (tracking + resolution)

// S1 focus pane ids — order defines the Tab ring.
func PaneBrowse() string      = "browse"
func PaneOrigin() string      = "origin"  // local-dir vs GitHub-URL source origin
func PaneUrl() string         = "url"     // GitHub repo URL (git origin)
func PaneRef() string         = "ref"     // optional branch / tag / commit (git origin)
func PaneTarget() string      = "target"
func PaneUnsupported() string = "unsupported"
func PaneRetry() string       = "retry"
func PaneAmbiguity() string   = "ambiguity"
func PaneScan() string        = "scan"

// S2 / S3 focus pane ids.
func PaneStart() string = "start"  // S2 start-run button
func PaneBack() string  = "back"   // S2 back button
func PaneTree() string  = "tree"   // S3 unit tree
func PaneLog() string   = "log"    // S3 activity log

func s1Panes() Array[string] =
    ArrayOf[string](
        PaneBrowse(),
        PaneOrigin(),
        PaneUrl(),
        PaneRef(),
        PaneTarget(),
        PaneUnsupported(),
        PaneRetry(),
        PaneAmbiguity(),
        PaneScan(),
    )

// Minimum viewport the full layout needs; below this a resize notice shows.
func MinCols() int = 60
func MinRows() int = 16

// Above this width S1 combines retry+backend onto one row; S3 keeps the split
// board side-by-side. Below it, both stack.
func WideCols() int = 86

// BrowseEntry is one row in the directory picker: a child directory (or the ".."
// parent), the absolute path it navigates to / commits, and a marker when the
// directory looks like a project root (carries a go.mod / package.json / Cargo.toml).
struct BrowseEntry(
    Name     string,
    Path     string,
    IsParent bool,
    Marker   string,
)

// BrowseState is the live directory picker (S7): the directory being listed, its
// entries (".." first, then child directories), the cursor, and a loading flag
// that's true between opening the screen and the async listing landing.
struct BrowseState(
    Dir     string,
    Entries Array[BrowseEntry],
    Cursor  int,
    Loading bool,
)

struct Model(
    Screens ScreenStack,
    Focus   FocusRing,
    // MakePort builds an engine port from a backend name ("mock"/"go"/"claude").
    // The S1 selection decides which name is passed when a scan starts; the
    // resulting port (Port) then drives the whole run.
    MakePort func(string) engine.EnginePort,
    Port     engine.EnginePort,
    // ScanGit acquires a remote SourceOrigin (clone-then-scan) for the
    // start-from-GitHub path — the engine's public source-acquisition bridge
    // (engine.ScanOrigin over a RepoCloner). The local-path origin never touches
    // it: it scans through Port.Scan exactly as before. The app wires the real git
    // cloner here; tests inject a deterministic stub.
    ScanGit  func(engine.SourceOrigin, string) engine.OriginScan,
    Cols     int,
    Rows     int,
    Frame    int,   // animation frame counter — advanced by ticks while loading/running
    // S1 interview
    SourceDir    string,
    Source       SourceInfo,
    OriginGit    bool,     // false = local directory, true = GitHub repo URL
    RepoUrl      string,   // git origin: the repo URL
    RepoRef      string,   // git origin: optional branch / tag / commit
    ScanError    string,   // a surfaced clone/scan failure (git origin), "" when clear
    TargetIdx    int,
    Unsupported  UnsupportedPolicy,
    Retry        int,
    Backend      AgentBackend,
    AmbiguityIdx int,
    Scanning     bool,
    // engine run state (plain value types from the public port)
    Workspace Option[engine.WorkspaceModel],
    Plan      Option[engine.MigrationPlan],
    Run       Option[engine.RunState],
    // dependency forest (plain value type from the public port)
    Forest     Option[engine.DependencyForest],
    DepCursor  int,        // S8 tree cursor (indexes straight into Forest.Deps)
    ForestSaveOk bool,     // last forest auto-save result (S8 indicator)
    // S2 / S3 navigation
    S2Focus    string,
    S3Focus    string,
    TreeCursor int,
    LogScroll  int,   // lines scrolled up from the tail (0 = following latest)
    // S5 clarification answer buffer (the unit under review/answer is TreeCursor)
    AnswerText string,
    // S7 directory picker (None unless the browser is open)
    Browse Option[BrowseState],
    // checkpoint / resume
    Persist     bool,                         // auto-save the run during ticks (app: on; tests: off)
    ResumeOffer Option[runview.LoadSummary],  // a checkpoint found at launch (S0 prompt)
    LastSaveOk  bool,                         // last auto-save result (S3 indicator)
)

// browseDirs is the small set of sample project paths the Browse control cycles.
func browseDirs() Array[string] =
    ArrayOf[string](
        "/workdir/myproject",
        "/workdir/sample-lib",
        "/workdir/legacy-app",
    )

// NewModel builds the initial state for the given engine-port factory and
// viewport. Claude is the only user-facing backend, so it is the default; the
// active Port is built from it once and reused for the whole run.
func NewModel(makePort func(string) engine.EnginePort, cols int, rows int) Model {
    val dir = browseDirs().Get(0)
    val defaultBackend = ClaudeBackend()
    return Model(
        Screens  = NewScreenStack(RouteS1()),
        Focus    = NewFocusRing(s1Panes()),
        MakePort = makePort,
        Port     = makePort(BackendName(defaultBackend)),
        ScanGit  = defaultScanGit(),
        Cols     = cols,
        Rows     = rows,
        Frame    = 0,
        SourceDir    = dir,
        Source       = detectSource(dir),
        OriginGit    = false,
        RepoUrl      = "",
        RepoRef      = "",
        ScanError    = "",
        TargetIdx    = 0,
        Unsupported  = FlagContinue(),
        Retry        = 3,
        Backend      = defaultBackend,
        AmbiguityIdx = 0,
        Scanning     = false,
        Workspace = None[engine.WorkspaceModel](),
        Plan      = None[engine.MigrationPlan](),
        Run       = None[engine.RunState](),
        Forest       = None[engine.DependencyForest](),
        DepCursor    = 0,
        ForestSaveOk = true,
        S2Focus    = PaneStart(),
        S3Focus    = PaneTree(),
        TreeCursor = 0,
        LogScroll  = 0,
        AnswerText = "",
        Browse      = None[BrowseState](),
        Persist     = false,
        ResumeOffer = None[runview.LoadSummary](),
        LastSaveOk  = true,
    )
}

// DefaultSourceDir is the project the launch resume-probe checks.
func DefaultSourceDir() string = browseDirs().Get(0)

// NewModelResume seeds the model from a launch checkpoint probe. A "loaded" or
// "corrupt" summary opens the S0 prompt on top of S1 (so Start fresh falls back
// to S1); "missing" is just a normal S1 start. `persist` enables auto-save during
// the run (the app passes true; tests pass false to stay IO-free).
func NewModelResume(
    makePort func(string) engine.EnginePort,
    offer runview.LoadSummary,
    persist bool,
    cols int,
    rows int,
) Model {
    val base = NewModel(makePort, cols, rows)
    if (offer.Kind == "missing") {
        return base.Copy(Persist = persist)
    }
    return base.Copy(
        Persist     = persist,
        ResumeOffer = Some(offer),
        Screens     = base.Screens.Push(RouteS0()),
    )
}

// TargetLang is the currently-selected target language label.
func (m Model) TargetLang() string =
    TargetLangOptions().Get(clampIdx(m.TargetIdx, TargetLangOptions().Length()))

// Ambiguity is the currently-selected ambiguity-default label.
func (m Model) Ambiguity() string =
    AmbiguityOptions().Get(clampIdx(m.AmbiguityIdx, AmbiguityOptions().Length()))
