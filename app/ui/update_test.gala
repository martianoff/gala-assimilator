package ui

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-assimilator/app/engine"
    "github.com/martianoff/gala-assimilator/app/runview"
    . "martianoff/gala/collection_immutable"
    str "martianoff/gala/strings"
    . "martianoff/gala/test"
)

// ============================================================================
// Reducer (Update) tests via StepAll — pure message sequences, no terminal.
// Cover S1 interview controls plus the engine flow: scan→plan→run→tick driving
// the assimilation to completion.
// ============================================================================

// mockFactory is the deterministic name→port factory used across UI tests — it
// ignores the name and always returns the offline MockEngine, so `gala test`
// never touches the live Claude backend regardless of the selected backend.
func mockFactory() func(string) engine.EnginePort = (name string) => engine.MockEngine()

func prog() Program[Model, Msg] = NewProgram(mockFactory(), 110, 30)

// StepAll2 continues a message sequence from an existing model (StepAll only
// starts from a Program's Initial).
func StepAll2(m Model, msgs Array[Msg]) Tuple[Model, Array[Cmd[Msg]]] =
    StepAll(Program[Model, Msg](
        Initial = m,
        Update  = (mm, msg) => update(mm, msg),
        View    = (mm) => view(mm),
    ), msgs)

// ticks builds n MRunTick messages (each StepAll-applied tick = one Advance,
// since the self-rescheduling AfterDelay future doesn't fire under StepAll).
func ticks(n int) Array[Msg] = ArrayTabulate[Msg](n, (i int) => MRunTick())

func doneOf(m Model) int = m.Run match {
    case Some(rs) => engine.CountByDone(rs)
    case None()   => 0
}

// ----- S1 interview ---------------------------------------------------------

func TestTabAdvancesFocus(t T) T {
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MFocusNext()))
    return Eq(t, m1.Focus.Current(), PaneOrigin())
}

func TestShiftTabWrapsToLastPane(t T) T {
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MFocusPrev()))
    return Eq(t, m1.Focus.Current(), PaneScan())
}

func TestCycleTargetWrapsAround(t T) T {
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MCycleTarget(), MCycleTarget(), MCycleTarget()))
    return Eq(t, m1.TargetLang(), "GALA")
}

func TestRetryStepperClampsAtMin(t T) T {
    val msgs = ArrayOf[Msg](
        MStepRetry(Dir = -1), MStepRetry(Dir = -1),
        MStepRetry(Dir = -1), MStepRetry(Dir = -1),
    )
    val (m1, _) = StepAll(prog(), msgs)
    return Eq(t, m1.Retry, RetryMin())
}

func TestSetUnsupportedPolicy(t T) T {
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MSetUnsupported(P = StopAll())))
    return IsTrue(t, UnsupportedEq(m1.Unsupported, StopAll()))
}

// Browse now opens the S7 directory picker (in a loading state) and emits the
// async listing Cmd, instead of cycling hardcoded paths.
func TestBrowseOpensPicker(t T) T {
    val (m1, cmds) = StepAll(prog(), ArrayOf[Msg](MBrowse()))
    val t1 = Eq(t, m1.Screens.Current(), RouteS7())
    val t2 = IsTrue(t1, cmds.NonEmpty())         // an Async listing Cmd was emitted
    return m1.Browse match {
        case Some(b) => IsTrue(t2, b.Loading)
        case None()  => IsTrue(t2, false)
    }
}

// browseFixture is a deterministic listing (no filesystem IO) with the cursor on
// a project-marked child directory.
func browseFixture() BrowseState =
    BrowseState(
        Dir     = "/workdir",
        Entries = ArrayOf[BrowseEntry](
            BrowseEntry(Name = "..",         Path = "/",                  IsParent = true,  Marker = ""),
            BrowseEntry(Name = "myproject",  Path = "/workdir/myproject", IsParent = false, Marker = "go.mod"),
            BrowseEntry(Name = "sample-lib", Path = "/workdir/sample",    IsParent = false, Marker = ""),
        ),
        Cursor  = 1,
        Loading = false,
    )

// A loaded listing is adopted and rendered in the picker.
func TestBrowseLoadedShowsEntries(t T) T {
    val msgs = ArrayOf[Msg](MBrowse(), MBrowseLoaded(State = browseFixture()))
    val (m1, _) = StepAll(prog(), msgs)
    val out = str.S(Snapshot(view(m1), 110, 30))
    val t1 = IsTrue(t, out.Contains("myproject"))
    return IsTrue(t1, out.Contains("go.mod"))
}

// Double-clicking a row descends into THAT row (not the stale cursor): it
// highlights the clicked index and emits the listing Cmd for its path.
func TestBrowseDoubleClickOpensClickedRow(t T) T {
    val msgs = ArrayOf[Msg](MBrowse(), MBrowseLoaded(State = browseFixture()), MBrowseOpenAt(Idx = 2))
    val (m1, cmds) = StepAll(prog(), msgs)
    val t1 = IsTrue(t, cmds.NonEmpty())   // a listing Cmd for the opened dir
    return m1.Browse match {
        case Some(b) => Eq(t1, b.Cursor, 2)   // the clicked row became the highlight
        case None()  => IsTrue(t1, false)
    }
}

// Selecting the highlighted directory commits it as the source and returns to S1.
func TestBrowseSelectSetsSourceAndPops(t T) T {
    val msgs = ArrayOf[Msg](MBrowse(), MBrowseLoaded(State = browseFixture()), MBrowseSelect())
    val (m1, _) = StepAll(prog(), msgs)
    val t1 = Eq(t, m1.SourceDir, "/workdir/myproject")
    return Eq(t1, m1.Screens.Current(), RouteS1())
}

// The async detection result lands on the S1 readout.
func TestSourceDetectedUpdatesReadout(t T) T {
    val info = SourceInfo(Lang = "Rust", Marker = "Cargo.toml found", FileCnt = 7, Detected = true)
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MSourceDetected(Info = info)))
    val t1 = Eq(t, m1.Source.Lang, "Rust")
    return IsTrue(t1, m1.Source.Detected)
}

// ----- empty / non-project source -------------------------------------------

func emptyPlan() engine.MigrationPlan = engine.MigrationPlan(Items = EmptyArray[engine.PlanItem]())

// Scanning a folder with no migratable units lands on S2 but focuses Back (a dead
// end), and the plan summary shows the explanatory empty state — not a start action.
func TestEmptyPlanRoutesToS2BackState(t T) T {
    val ws = engine.MockEngine().Scan(engine.ScanRequest(Root = "/x"))
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MScanPlanned(Workspace = ws, Plan = emptyPlan())))
    val t1 = Eq(t, m1.Screens.Current(), RouteS2())
    val t2 = Eq(t1, m1.S2Focus, PaneBack())
    val out = str.S(Snapshot(view(m1), 110, 30))
    return IsTrue(t2, out.Contains("No migratable units"))
}

// Starting a run with an empty plan is a no-op: it never enters S3.
func TestEmptyPlanStartIsGuarded(t T) T {
    val ws = engine.MockEngine().Scan(engine.ScanRequest(Root = "/x"))
    val msgs = ArrayOf[Msg](MScanPlanned(Workspace = ws, Plan = emptyPlan()), MStartRun())
    val (m1, _) = StepAll(prog(), msgs)
    return IsFalse(t, m1.Screens.Current() == RouteS3())
}

// ----- engine flow: scan → plan → run → tick --------------------------------

func TestScanRequestedEntersScanningState(t T) T {
    val (m1, cmds) = StepAll(prog(), ArrayOf[Msg](MScanRequested()))
    val t1 = IsTrue(t, m1.Scanning)
    return IsTrue(t1, cmds.NonEmpty())   // an Async Scan→Plan Cmd was emitted
}

func TestScanPlannedRoutesToS2(t T) T {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val plan = port.Plan(ws)
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MScanPlanned(Workspace = ws, Plan = plan)))
    val t1 = Eq(t, m1.Screens.Current(), RouteS2())
    return IsFalse(t1, m1.Scanning)
}

func TestRunStartedRoutesToS3(t T) T {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val st = port.Run(port.Plan(ws))
    val setup = ArrayOf[Msg](
        MScanPlanned(Workspace = ws, Plan = port.Plan(ws)),
        MRunStarted(State = st),
    )
    val (m1, _) = StepAll(prog(), setup)
    return Eq(t, m1.Screens.Current(), RouteS3())
}

func TestTicksIncreaseDoneCount(t T) T {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val plan = port.Plan(ws)
    val st = port.Run(plan)
    val setup = ArrayOf[Msg](
        MScanPlanned(Workspace = ws, Plan = plan),
        MRunStarted(State = st),
    )
    val (m0, _) = StepAll(prog(), setup)
    val (m1, _) = StepAll(prog(), setup.AppendAll(ticks(3)))
    return IsTrue(t, doneOf(m1) > doneOf(m0))   // first unit finished after 3 ticks
}

func TestRunDrivesToCompletion(t T) T {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val plan = port.Plan(ws)
    val st = port.Run(plan)
    val setup = ArrayOf[Msg](
        MScanPlanned(Workspace = ws, Plan = plan),
        MRunStarted(State = st),
    )
    val (m1, _) = StepAll(prog(), setup.AppendAll(ticks(40)))
    return m1.Run match {
        case Some(rs) => {
            val total = rs.Units.Length()
            val t1 = Eq(t, engine.CountByDone(rs), total)        // all units done
            return IsFalse(t1, runview.AnyActionable(rs))         // nothing left to drive
        }
        case None() => IsTrue(t, false)
    }
}

// ----- project gate (compile + test the integrated output) ------------------

func greenEval() engine.ProjectEvaluation =
    engine.ProjectEvaluation(
        Language = "GALA", Materialized = true,
        Compiled = true, CompileOutput = "", TestsRun = true, TestsPassed = true, TestOutput = "",
        UnitsEmitted = 4, UnitsExcluded = EmptyArray[engine.UnitId](), Note = "")

func redEval() engine.ProjectEvaluation =
    engine.ProjectEvaluation(
        Language = "GALA", Materialized = true,
        Compiled = false, CompileOutput = "bundled.gala:10:22 missing '{'",
        TestsRun = false, TestsPassed = false, TestOutput = "",
        UnitsEmitted = 4, UnitsExcluded = EmptyArray[engine.UnitId](), Note = "")

func runToFixpoint() Array[Msg] {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val plan = port.Plan(ws)
    val st = port.Run(plan)
    return ArrayOf[Msg](
        MScanPlanned(Workspace = ws, Plan = plan),
        MRunStarted(State = st),
    ).AppendAll(ticks(40))
}

// A green project evaluation is stored and counts as one gate round, so S6 can report
// "compiles & tests pass".
func TestProjectGateGreenStoresEvaluation(t T) T {
    val (m1, _) = StepAll(prog(), runToFixpoint().Append(MProjectEvaluated(Eval = greenEval())))
    val t1 = Eq(t, m1.ProjectAttempts, 1)
    return m1.ProjectEval match {
        case Some(e) => IsTrue(t1, engine.ProjectGreen(e))
        case None()  => Fail(t1, "a green evaluation must be stored for the report")
    }
}

// A non-green evaluation with budget remaining is recorded (one round spent) and the
// gate is no longer "evaluating" — the loop will feed the diagnostics back and resume.
func TestProjectGateNonGreenFeedsBackWithinBudget(t T) T {
    val (m1, _) = StepAll(prog(), runToFixpoint().Append(MProjectEvaluated(Eval = redEval())))
    val t1 = Eq(t, m1.ProjectAttempts, 1)
    val t2 = IsFalse(t1, m1.ProjectEvaluating)
    return m1.ProjectEval match {
        case Some(e) => IsFalse(t2, engine.ProjectGreen(e))
        case None()  => Fail(t2, "the evaluation must be stored")
    }
}

// The project gate gives the engine a bounded number of fix rounds: feeding back
// `DefaultMaxProjectAttempts` non-green evaluations spends exactly that budget (no
// infinite re-translation), and the run then settles.
func TestProjectGateNonGreenSettlesAtBudget(t T) T {
    val rounds = engine.DefaultMaxProjectAttempts()
    val evals = ArrayTabulate[Msg](rounds, (i int) => MProjectEvaluated(Eval = redEval()))
    val (m1, _) = StepAll(prog(), runToFixpoint().AppendAll(evals))
    return Eq(t, m1.ProjectAttempts, rounds)
}

// ----- navigation -----------------------------------------------------------

func TestBackFromS2ReturnsToS1(t T) T {
    val port = engine.MockEngine()
    val ws = port.Scan(engine.ScanRequest(Root = "/x"))
    val msgs = ArrayOf[Msg](
        MScanPlanned(Workspace = ws, Plan = port.Plan(ws)),
        MBack(),
    )
    val (m1, _) = StepAll(prog(), msgs)
    return Eq(t, m1.Screens.Current(), RouteS1())
}

func TestBackAtRootQuits(t T) T {
    val (_, cmds) = StepAll(prog(), ArrayOf[Msg](MBack()))
    return IsTrue(t, cmds.Exists((c) => IsQuit(c)))
}

func TestResizeUpdatesViewport(t T) T {
    val (m1, _) = StepAll(prog(), ArrayOf[Msg](MResized(W = 80, H = 30)))
    val t1 = Eq(t, m1.Cols, 80)
    return Eq(t1, m1.Rows, 30)
}
