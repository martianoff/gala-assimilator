package engine

// The agent-run contract: the translator port (AgentRunner) plus its stream-as-
// data transcript (RunTranscript) and sealed terminus (RunOutcome).
//
// TEMPORARY IN-REPO STAND-IN for the generic gala-acp library. The architect
// brief is to consume `acp.AgentRunner[A,R,C]` / `acp.RunTranscript` /
// `acp.RunOutcome` from github.com/martianoff/gala-acp and delete this copy.
// gala-acp v0.1.0 RESOLVES and its GALA sources transpile cleanly under our
// 0.49.2 toolchain — but 0.49.2's dependency manager does not propagate
// gala-acp's transitive `// go` dependency (github.com/google/uuid): it emits a
// `require` with neither a `replace` to a local copy nor a go.sum entry, so any
// package importing gala-acp fails the workspace build/test with
//   "missing go.sum entry for github.com/google/uuid".
// Until the toolchain is bumped, this file mirrors the library's run.gala shape
// (specialized to our payloads) so only these few types get swapped out later.
//
// Transport-neutral: pure data, no gala_tui / app/ui, no IO.

import (
    . "martianoff/gala/collection_immutable"
)

// ----------------------------------------------------------------------------
// Run transcript — stream-as-data
// ----------------------------------------------------------------------------

// RunStep is one non-terminal item the agent emits while working. Sealed with a
// single case for now: a run terminus is deliberately NOT a RunStep, so a step
// can never be mistaken for the end of a run.
sealed type RunStep {
    case StepProgress(Event ProgressEvent)
}

// RunOutcome is the sealed terminus of a run — exactly how a Submit ends. Sealed
// so every consumer handles all three ways a run can finish. (Specialized here;
// the library type is generic over the result / clarification payloads.)
sealed type RunOutcome {
    case OutcomeResult(Value Result)               // agent produced a translation
    case OutcomeClarification(Value Clarification)  // agent needs an answer; run ends here
    case OutcomeAborted(Reason string)              // wholesale failure / nothing produced / cancelled
}

// RunTranscript is the full outcome of a Submit: the ordered intermediate steps
// followed by exactly one sealed terminus.
struct RunTranscript(
    Steps Array[RunStep],
    Final RunOutcome,
)

// CancelOutcome is the result of asking the runner to cancel a task — a pure
// acknowledgement value; the actual teardown is the implementation's IO.
sealed type CancelOutcome {
    case Cancelled()  // the task was running and has been stopped
    case NotRunning() // no live task with that id (already done / never seen)
}

// ----------------------------------------------------------------------------
// The AgentRunner port (translator backend)
// ----------------------------------------------------------------------------

// AgentRunner is the translator port: a struct of function values (the GALA-
// idiomatic port). Submit: TaskAssignment -> RunTranscript; Cancel: TaskId ->
// CancelOutcome. The function values are pure from the contract's view; a real
// backend performs its IO inside them and returns the resulting value.
struct AgentRunner(
    Submit func(TaskAssignment) RunTranscript,
    Cancel func(TaskId) CancelOutcome,
)

// RunOutcomeTag projects a RunOutcome to a stable lowercase token.
func RunOutcomeTag(o RunOutcome) string = o match {
    case OutcomeResult(_)        => "result"
    case OutcomeClarification(_) => "clarification"
    case OutcomeAborted(_)       => "aborted"
}

// progressStep is the in-transcript step builder for a domain progress note.
func progressStep(task TaskId, phase ProgressPhase, note string) RunStep =
    StepProgress(Event = ProgressEvent(Task = task, Phase = phase, Note = note))

// ----------------------------------------------------------------------------
// Deterministic backends (the extraction seam)
// ----------------------------------------------------------------------------

// MockTranslator is the default translator this contract ships: a runner whose
// Submit deterministically streams Reading -> Emitting -> Verifying and ends in
// OutcomeResult (the success path), and whose Cancel reports Cancelled. The real
// extracted translator replaces this constructor.
func MockTranslator() AgentRunner =
    AgentRunner(
        Submit = (a TaskAssignment) => translatorTranscript(a),
        Cancel = (_ TaskId) => Cancelled(),
    )

// ScriptedRunner pins the terminus a Submit produces and the CancelOutcome a
// Cancel returns, so every RunOutcome / CancelOutcome case can be exercised
// THROUGH THE PORT (not just via hand-built transcripts). The progress prefix is
// the same faithful Reading->Emitting->Verifying shape.
func ScriptedRunner(outcome RunOutcome, cancel CancelOutcome) AgentRunner =
    AgentRunner(
        Submit = (a TaskAssignment) => RunTranscript(
            Steps = mockSteps(a.Task),
            Final = outcome,
        ),
        Cancel = (_ TaskId) => cancel,
    )

func translatorTranscript(a TaskAssignment) RunTranscript =
    RunTranscript(
        Steps = mockSteps(a.Task),
        Final = OutcomeResult(Value = Result(
            Task       = a.Task,
            TargetText = "// mock translation",
            Rationale  = "deterministic mock output (extraction seam stub)",
            Flags      = EmptyArray[UnsupportedFlag](),
        )),
    )

func mockSteps(task TaskId) Array[RunStep] =
    ArrayOf[RunStep](
        progressStep(task, PhaseReading(), "reading source unit"),
        progressStep(task, PhaseEmitting(), "emitting target text"),
        progressStep(task, PhaseVerifying(), "verifying output"),
    )
