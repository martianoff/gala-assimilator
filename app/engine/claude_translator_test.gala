package engine

// Tests for backend selection and the Claude backend's construction. The LIVE
// Claude pump (claudeSubmit / pumpClaude) is exercised only at runtime with real
// credentials — these tests stay fully offline: they never reach a Submit, so no
// `claude` subprocess is ever spawned.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/test"
    acp "github.com/martianoff/gala-acp"
)

// extractTargetSource salvages clean GALA when the model prepends prose — the exact
// "missing 'package'" defect seen on real output (a "Here is the translation:" preamble
// before `package`). Everything before the first `package` line is dropped.
func TestExtractStripsLeadingProse(t T) T =
    Eq(t, extractTargetSource("Here is the translation:\n\npackage main\n\nfunc Add(a int) int = a\n"),
          "package main\n\nfunc Add(a int) int = a\n")

// A markdown-fenced block yields bare source (fence lines removed).
func TestExtractStripsFences(t T) T =
    Eq(t, extractTargetSource("```gala\npackage core\n```"), "package core")

// Already-clean source (starts at `package`) passes through unchanged.
func TestExtractKeepsCleanSource(t T) T =
    Eq(t, extractTargetSource("package x\n\nfunc F() int = 1\n"), "package x\n\nfunc F() int = 1\n")

// No `package` line: return the trimmed text so the gate surfaces the real problem,
// rather than this step silently emitting nothing.
func TestExtractNoPackageReturnsTrimmed(t T) T =
    Eq(t, extractTargetSource("  some non-code text  "), "some non-code text")

// The default / offline backend drives the stub workspace to completion through
// the acp-backed run pipeline — selection + scan + plan + run + gate end to end.
func TestSelectBackendMockRunsToDone(t T) T {
    val eng = SelectBackend("mock")
    val finished = RunToCompletion(eng, eng.Run(eng.Plan(eng.Scan(ScanRequest(Root = ".")))))
    return Eq(t, CountByDone(finished), 4)
}

// The "claude" backend CONSTRUCTS without IO (its live transport is only touched at
// Submit time, which this test never reaches), and its pure port ops work: an
// empty run checkpoints and resumes with no loss.
func TestClaudeBackendConstructsAndCheckpoints(t T) T {
    val eng   = SelectBackend("claude")
    val empty = RunState(Units = EmptyArray[UnitRun](), Log = EmptyArray[EngineEvent]())
    val rt    = eng.Resume(eng.Checkpoint(empty))
    return Eq(t, rt.Units.Length(), 0)
}

// ClaudeTranslator is constructible (the hook a future offline fake-transport test
// drives). Building the runner spawns nothing; its Cancel is a pure acknowledgement.
func TestClaudeTranslatorConstructs(t T) T {
    val runner = ClaudeTranslator()
    return Eq(t, acp.CancelOutcomeTag(runner.Cancel("task-1")), "cancelled")
}
