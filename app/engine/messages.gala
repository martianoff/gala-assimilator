package engine

// The assimilator's DOMAIN ACP — the concrete payload types the engine and its
// agents speak. This is the domain face of the agent-run contract whose port and
// transcript live in run.gala.
//
// NOTE ON PACKAGING: this is ONE `engine` package spanning several files
// (messages / run / workspace / port). A split into sibling packages
// (domain / lang / port, and later frontend / ir / backend) is the intended
// shape, but GALA 0.49.2 does not reliably resolve intra-module package imports
// (the gen workspace omits the self-module replace), so the foundation ships as a
// single package until the toolchain is bumped. See the report / run.gala header.
//
// Transport-neutral (CLAUDE.md / architecture.md): NO gala_tui, NO app/ui, no IO.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
)

// ----------------------------------------------------------------------------
// Roles
// ----------------------------------------------------------------------------

// Role is an agent the engine can address. The Orchestrator (the engine) is the
// caller, not a Role.
sealed type Role {
    case Translator() // turns one source unit into target-language text
    case Reviewer()   // judges a translation and returns a Verdict
}

// ----------------------------------------------------------------------------
// Identifiers & value types  (UnitId is defined in workspace.gala)
// ----------------------------------------------------------------------------

// TaskId identifies a single dispatched unit of work for its whole lifecycle —
// the join key between an assignment and every message that answers it.
struct TaskId(Value string)

// DependencySnippet is one piece of surrounding context a translator may need:
// the signature/text of a symbol the unit depends on, named for reference.
struct DependencySnippet(Name string, Text string)

// SourceContext is the source text plus the dependency context handed to a
// translator — everything the agent is allowed to read for one unit.
struct SourceContext(
    SourceText   string,
    Dependencies Array[DependencySnippet],
)

// TargetConventions tells the agent what "good output" looks like for the target
// language: the language name plus free-form convention notes.
struct TargetConventions(
    Language string,
    Notes    Array[string],
)

// UnsupportedFlag is the "surface, don't guess" signal. When a source construct
// has no faithful target, the agent flags it here rather than emitting a
// translation it cannot justify as semantics-preserving.
struct UnsupportedFlag(
    Construct string,
    Reason    string,
)

// PriorFailure is the feedback attached to a RETRY: why the previous attempt was
// rejected plus the flags it raised, so the agent can do better next time.
struct PriorFailure(
    Summary string,
    Flags   Array[UnsupportedFlag],
)

// VerdictOutcome is a reviewer's binary call. Reasons ride the Verdict itself.
sealed type VerdictOutcome {
    case Accept()
    case Reject()
}

// ----------------------------------------------------------------------------
// ProgressUpdate phases
// ----------------------------------------------------------------------------

// ProgressPhase is the coarse stage a ProgressUpdate reports — enough to drive a
// live UI ticker without parsing free-form notes. (Cases are `Phase*`-prefixed so
// they don't collide with the engine's UnitStatus lifecycle in this one package.)
sealed type ProgressPhase {
    case PhaseReading()   // ingesting source + dependency context
    case PhaseEmitting()  // producing target text
    case PhaseVerifying() // self-checking the emitted output
}

// phaseFromTag maps acp's opaque progress-phase string back onto the engine's
// sealed ProgressPhase at the run boundary (finishUnit). The engine's own runners
// emit the canonical "reading" / "emitting" / "verifying" tags; any other tag a
// backend might stream defaults to PhaseReading so an unknown phase still renders
// as live activity rather than crashing the exhaustive match.
func phaseFromTag(tag string) ProgressPhase {
    if tag == "emitting"  { return PhaseEmitting() }
    if tag == "verifying" { return PhaseVerifying() }
    return PhaseReading()
}

// ----------------------------------------------------------------------------
// Domain message payloads — the assignment / result / clarification + companions
// ----------------------------------------------------------------------------

// TaskAssignment: the unit to translate, its curated source context, and the
// target conventions, plus two re-submission carriers that keep the port
// one-shot/stateless:
//   - PriorFailure: populated only on a RETRY (after a reviewer Reject).
//   - Answers: the accumulated answers to prior Clarifications on this unit,
//     populated only on a RE-SUBMISSION after the agent ended a run with an
//     OutcomeClarification. Mirrors PriorFailure exactly — the engine never holds
//     a live reply channel; it threads resolved Answers back in on the next
//     assignment (the clarification-resolution loop).
struct TaskAssignment(
    Task         TaskId,
    Unit         UnitId,
    Source       SourceContext,
    Target       TargetConventions,
    PriorFailure Option[PriorFailure],
    Answers      Array[Answer],
)

// Result: the terminal output of a translation — emitted target text, the
// agent's rationale, and any UnsupportedFlags raised.
struct Result(
    Task       TaskId,
    TargetText string,
    Rationale  string,
    Flags      Array[UnsupportedFlag],
)

// Clarification: a question the agent needs answered to proceed. The run ends
// here; the engine replies with an Answer carrying the same TaskId.
struct Clarification(
    Task     TaskId,
    Question string,
)

// Answer (engine -> agent): the response to a Clarification, joined by TaskId.
struct Answer(
    Task     TaskId,
    Response string,
)

// Verdict (reviewer -> engine): the outcome of a review plus its reasons. On a
// Reject, the reasons become the next attempt's PriorFailure summary.
struct Verdict(
    Task    TaskId,
    Outcome VerdictOutcome,
    Reasons Array[string],
)

// ProgressUpdate (agent -> engine): a streamed status note that drives the live
// UI ticker. Non-terminal: many per task.
//
// NAMING — this is the engine's own progress type, renamed from `ProgressEvent`.
// gala-acp also exports a `ProgressEvent` (its string-keyed, transport-neutral
// progress note), and GALA/Go forbid the same identifier in both a file's
// dot-import scope and the package block. Because the engine MUST dot-import acp to
// destructure its sealed run outcomes (qualified case patterns don't work, and a
// module-local helper sub-package doesn't resolve under the 0.49.2 toolchain), the
// engine cannot also declare a `ProgressEvent`. The fields (Task / Phase / Note)
// are unchanged, so a consumer that destructures EngineEvent.EvProgress and reads
// them is unaffected; only the type's name changed.
struct ProgressUpdate(
    Task  TaskId,
    Phase ProgressPhase,
    Note  string,
)

// ----------------------------------------------------------------------------
// The sealed message set — completeness for transcript/logging
// ----------------------------------------------------------------------------

// Message is the closed set of everything that crosses the ACP boundary in
// either direction. Sealed so every consumer handles all six cases.
sealed type Message {
    case MsgTaskAssignment(Payload TaskAssignment) // engine   -> agent
    case MsgProgressEvent(Payload ProgressUpdate)  // agent    -> engine
    case MsgResult(Payload Result)                 // agent    -> engine
    case MsgClarification(Payload Clarification)   // agent    -> engine
    case MsgAnswer(Payload Answer)                 // engine   -> agent
    case MsgVerdict(Payload Verdict)               // reviewer -> engine
}

// MessageKind pins exhaustive matching over the sealed set — one place that
// breaks to compile if the message set ever grows.
func MessageKind(m Message) string {
    return m match {
        case MsgTaskAssignment(_) => "task_assignment"
        case MsgProgressEvent(_)  => "progress_event"
        case MsgResult(_)         => "result"
        case MsgClarification(_)  => "clarification"
        case MsgAnswer(_)         => "answer"
        case MsgVerdict(_)        => "verdict"
    }
}
