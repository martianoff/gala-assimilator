package engine

// GoEngine — the EnginePort wired to the REAL Go frontend. Its Scan reads an
// actual project from disk (ScanGoWorkspace, goscan.gala) and its Plan feeds each
// unit's REAL file content into the plan. Everything else (Run / Advance / act /
// answer / checkpoint) reuses the exact pure machinery MockEngine uses — only the
// front of the pipeline changes.
//
// NOTE — translation is still the MOCK. This slice proves the scan -> plan -> run
// pipeline end-to-end on real Go input; it does NOT yet translate. The real agent
// backend remains blocked by the gala-acp `uuid` transitive-dependency issue
// (gala 0.52.0 toolchain; see the run.gala header for the precise failure), so the
// runner here is still MockTranslator. Swapping in the real translator is a runner
// substitution behind GoEngineWith — no pipeline change.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
)

// GoEngine is the default real-frontend engine, driven by the MockTranslator (the
// backend is not yet available — see the file header).
func GoEngine() EnginePort = GoEngineWith(MockTranslator())

// GoEngineWith builds the real-frontend engine over a caller-supplied translator,
// so a future real backend (or a ScriptedRunner in tests) drops in unchanged.
func GoEngineWith(runner AgentRunner) EnginePort = EnginePort(
    Scan          = (req ScanRequest) => ScanGoWorkspace(req.Root),
    Plan          = (m WorkspaceModel) => goPlanFor(m),
    Run           = (p MigrationPlan) => runFor(p),
    Advance       = (s RunState) => advance(runner, s),
    Events        = (s RunState) => s.Log,
    ActOnUnit     = (s RunState, id UnitId, a UnitAction) => actOnUnit(s, id, a),
    AnswerBlocker = (s RunState, id UnitId, ans Answer) => answerBlocker(s, id, ans),
    Checkpoint    = (s RunState) => Checkpoint(Units = s.Units, Log = s.Log),
    Resume        = (c Checkpoint) => RunState(Units = c.Units, Log = c.Log),
)

// goPlanFor builds the plan from a scanned workspace, threading each unit's REAL
// source text (and a best-effort dependency list parsed from its imports) into the
// SourceContext the translator will receive. This is the one place the mock and
// real planners differ: the mock synthesizes "// source: <path>", this carries the
// file content discovered on disk.
func goPlanFor(model WorkspaceModel) MigrationPlan {
    val items = model.Packages.FlatMap((p Package) =>
        p.Units.Map((u Unit) => PlanItem(
            Unit   = u.Id,
            Source = SourceContext(
                SourceText   = u.Source,
                Dependencies = unitDependencies(u),
            ),
            Target = TargetConventions(Language = "go", Notes = EmptyArray[string]()),
        )))
    return MigrationPlan(Items = items)
}

// unitDependencies is the best-effort dependency context for a unit: one
// DependencySnippet per imported path recovered from its source. Text is left
// empty — this slice surfaces WHICH symbols the unit depends on; resolving each to
// its definition is future work, not faked here.
func unitDependencies(u Unit) Array[DependencySnippet] =
    parseImports(u.Source).Map((imp string) =>
        DependencySnippet(Name = imp, Text = ""))
