package engine

// GoEngine — the EnginePort wired to the REAL Go frontend. Its Scan reads an
// actual project from disk (ScanGoWorkspace, goscan.gala) and its Plan feeds each
// unit's REAL file content into the plan. Everything else (Run / Advance / act /
// answer / checkpoint) reuses the exact pure machinery MockEngine uses — only the
// front of the pipeline changes.
//
// Backend: GoEngine defaults to the deterministic MockTranslator (offline, no
// credentials), so it scans and runs real Go input without a network. To drive
// real translation, build the same frontend over the live Claude backend —
// `ClaudeEngine()` (claude_translator.gala) is exactly GoEngineWithVerifier with
// ClaudeTranslator() as the runner. Swapping the backend is a runner substitution
// behind GoEngineWithVerifier; the scan -> plan -> run -> gate pipeline is unchanged.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    acp "github.com/martianoff/gala-acp"
)

// GoEngine is the default real-frontend engine, driven by the MockTranslator and
// the deterministic MockVerifier (neither real backend is available yet — see the
// file header and verify.gala).
func GoEngine() EnginePort = GoEngineWith(MockTranslator())

// GoEngineWith builds the real-frontend engine over a caller-supplied translator
// (with the default MockVerifier), so a future real backend (or a ScriptedRunner
// in tests) drops in unchanged.
func GoEngineWith(runner acp.AgentRunner[TaskAssignment, Result, Clarification]) EnginePort = GoEngineWithVerifier(runner, MockVerifier())

// GoEngineWithVerifier builds the real-frontend engine over a caller-supplied
// runner AND verifier — the seam where a real `gala test` verifier replaces the
// mock once translation emits real GALA, with no change to the scan -> plan -> run
// -> gate pipeline. Uses the default per-unit fix-loop cap; GoEngineWithVerifierCap
// sets a custom one.
func GoEngineWithVerifier(runner acp.AgentRunner[TaskAssignment, Result, Clarification], verifier Verifier) EnginePort =
    GoEngineWithVerifierCap(runner, verifier, DefaultMaxAttempts())

// GoEngineWithVerifierCap is GoEngineWithVerifier with a configurable per-unit
// attempt cap on the translate -> verify -> fix loop. It wires the OFFLINE
// MockProjectGate for the whole-project gate (its default mock translator emits no
// compilable GALA); GoEngineWithGate injects the REAL toolchain gate for the live
// backend (ClaudeEngine).
func GoEngineWithVerifierCap(runner acp.AgentRunner[TaskAssignment, Result, Clarification], verifier Verifier, maxAttempts int) EnginePort =
    GoEngineWithGate(runner, verifier, maxAttempts, MockProjectGate())

// GoEngineWithGate is GoEngineWithVerifierCap plus an injected ProjectGate — the seam
// where the live backend wires the real `gala build`/`gala test` whole-project gate
// (ToolchainProjectGate) while the offline frontends keep the always-green stub.
func GoEngineWithGate(runner acp.AgentRunner[TaskAssignment, Result, Clarification], verifier Verifier, maxAttempts int, gate ProjectGate) EnginePort = EnginePort(
    Scan          = (req ScanRequest) => ScanGoWorkspace(req.Root),
    Plan          = (m WorkspaceModel) => goPlanFor(m),
    Run           = (p MigrationPlan) => runFor(p),
    Advance       = (s RunState) => advance(runner, verifier, maxAttempts, s),
    Events        = (s RunState) => s.Log,
    ActOnUnit     = (s RunState, id UnitId, a UnitAction) => actOnUnit(s, id, a),
    AnswerBlocker  = (s RunState, id UnitId, ans Answer) => answerBlocker(s, id, ans),
    Checkpoint     = (s RunState) => Checkpoint(Units = s.Units, Log = s.Log),
    Resume         = (c Checkpoint) => RunState(Units = c.Units, Log = c.Log),
    SaveCheckpoint = (s RunState, path string) => saveCheckpoint(s, path),
    LoadCheckpoint = (path string) => loadCheckpoint(path),
    Integrate      = (s RunState, m WorkspaceModel, outRoot string) => integrateProject(s, m, outRoot),
    EvaluateProject      = (s RunState, m WorkspaceModel) => gate.Evaluate(s, m),
    ApplyProjectFeedback = (s RunState, e ProjectEvaluation) => gate.Feedback(s, e),
    // Forest: GoEngine wires the REAL git cloner (RealRepoCloner over GitCliRunner) so a
    // real migration clones each dependency into its own folder. The clone is the
    // toolchain edge — exercised on the live round, never by `gala test` (the suite
    // drives the forest through the free functions with a MockRepoCloner).
    ResolveDeps     = (m WorkspaceModel) => resolveForest(SelectResolver("go"), m, depsBaseFor(m), DefaultMaxDepth()),
    AdvanceForest   = (f DependencyForest) => advanceForest(RealRepoCloner(GitCliRunner()), SelectResolver("go"), runner, verifier, maxAttempts, f),
    ActOnDependency = (f DependencyForest, id DependencyId, a DepAction) => actOnDependency(f, id, a),
    SaveForest      = (f DependencyForest, path string) => saveForest(f, path),
    LoadForest      = (path string) => loadForest(path),
)

// goPlanFor builds the plan from a scanned workspace, threading each unit's REAL
// source text (and a best-effort dependency list parsed from its imports) into the
// SourceContext the translator will receive. This is the one place the mock and
// real planners differ: the mock synthesizes "// source: <path>", this carries the
// file content discovered on disk.
func goPlanFor(model WorkspaceModel) MigrationPlan =
    MigrationPlan(Items = model.Packages.FlatMap((p Package) => goPlanItemsForPackage(p)))

// goPlanItemsForPackage builds one PlanItem per unit carrying its REAL source text,
// and attaches the package's 1:1 source tests (computed once via sourceTestRefs —
// AddedTest excluded) as each unit's verify-gate input.
func goPlanItemsForPackage(p Package) Array[PlanItem] {
    val tests = sourceTestRefs(p)
    val target = GalaTargetConventions()
    return p.Units.Map((u Unit) => PlanItem(
        Unit        = u.Id,
        Source      = SourceContext(
            SourceText   = u.Source,
            Dependencies = unitDependencies(u),
        ),
        Target      = target,
        SourceTests = tests,
    ))
}

// GalaTargetConventions is the TARGET-language brief the live translator receives: the
// GALA idioms that turn a transliteration into an idiomatic migration. The source is
// Go (imperative, mutable); faithful GALA is functional and immutable — so these notes
// steer the agent to TRANSFORM the paradigm, not transcribe it, while the project gate
// holds the line on semantics. (The deterministic mock planner keeps the old stub
// conventions; only the live Go frontend feeds these to a real agent.)
func GalaTargetConventions() TargetConventions =
    TargetConventions(
        Language = "GALA",
        Notes = ArrayOf[string](
            "Produce IDIOMATIC GALA — translate the source's INTENT into GALA's paradigm, not its syntax line-for-line.",
            "GALA is functional, Elm-architecture, immutable-by-default: prefer pure functions and values over statements and in-place mutation.",
            "Turn imperative constructs functional: loops -> map/filter/fold over immutable collections; reassignment -> new bound vals; mutation -> Copy(...) producing a new value.",
            "Model alternatives as sealed types with EXHAUSTIVE match instead of enums+switch or nil checks; make illegal states unrepresentable.",
            "Keep side effects as values (Cmd / effect descriptions) at the edges; never inline IO inside pure logic.",
            "Bind a receiver to a val before .Copy(...) (Copy re-invokes the receiver per unmodified field); don't wrap a discarded call in `val _ =`.",
            "Preserve observable SEMANTICS exactly; if a construct has no faithful GALA form, emit a flagged TODO rather than guessing.",
        ),
    )

// unitDependencies is the best-effort dependency context for a unit: one
// DependencySnippet per imported path recovered from its source. Text is left
// empty — this slice surfaces WHICH symbols the unit depends on; resolving each to
// its definition is future work, not faked here.
func unitDependencies(u Unit) Array[DependencySnippet] =
    parseImports(u.Source).Map((imp string) =>
        DependencySnippet(Name = imp, Text = ""))
