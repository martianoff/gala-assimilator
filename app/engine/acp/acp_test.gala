package acp

// Internal tests for the ACP contract (package acp, per CLAUDE.md).
//
// They prove the contract is usable as data: each of the six messages can be
// constructed, the sealed set is exhaustively matchable, and the MockRunner
// seam produces a ProgressEvent-then-Result transcript.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/test"
)

// ----------------------------------------------------------------------------
// Fixtures
// ----------------------------------------------------------------------------

func sampleAssignment() TaskAssignment =
    TaskAssignment(
        Task = TaskId(Value = "task-1"),
        Unit = UnitId(Value = "unit-1"),
        Source = SourceContext(
            SourceText   = "func id(x int) int = x",
            Dependencies = ArrayOf[DependencySnippet](
                DependencySnippet(Name = "int", Text = "builtin"),
            ),
        ),
        Target = TargetConventions(
            Language = "go",
            Notes    = ArrayOf[string]("gofmt", "no naked returns"),
        ),
        PriorFailure = None[PriorFailure](),
    )

// ----------------------------------------------------------------------------
// Constructing each of the six messages
// ----------------------------------------------------------------------------

// allSixMessages builds one Message of every case in the sealed set, in the
// declared order. If a case is added/removed, this list stops matching the
// MessageKind exhaustive match and the suite breaks — by design.
func allSixMessages() Array[Message] {
    val task = TaskId(Value = "task-1")
    return ArrayOf[Message](
        MsgTaskAssignment(Payload = sampleAssignment()),
        MsgProgressEvent(Payload = ProgressEvent(
            Task = task, Phase = Reading(), Note = "reading",
        )),
        MsgResult(Payload = Result(
            Task       = task,
            TargetText = "x",
            Rationale  = "identity",
            Flags      = EmptyArray[UnsupportedFlag](),
        )),
        MsgClarification(Payload = Clarification(
            Task = task, Question = "is x nullable?",
        )),
        MsgAnswer(Payload = Answer(Task = task, Response = "no")),
        MsgVerdict(Payload = Verdict(
            Task    = task,
            Outcome = Accept(),
            Reasons = ArrayOf[string]("semantics preserved"),
        )),
    )
}

func TestConstructAllSixMessages(t T) T =
    Eq(t, allSixMessages().Length(), 6)

// TestMessageKindExhaustive walks every constructed message through the
// exhaustive MessageKind match and checks the expected tags, demonstrating
// pattern-matching over the whole sealed set.
func TestMessageKindExhaustive(t T) T {
    val msgs = allSixMessages()
    val expected = ArrayOf[string](
        "task_assignment",
        "progress_event",
        "result",
        "clarification",
        "answer",
        "verdict",
    )
    var i = 0
    var t2 = t
    for i < msgs.Length() {
        t2 = Eq(t2, MessageKind(msgs.Get(i)), expected.Get(i))
        i = i + 1
    }
    return t2
}

// TestMatchDirectionTags shows a second exhaustive match over Message — here
// classifying each message by who sends it — to confirm the sealed set drives
// real branching logic, not just a tag string.
func TestMatchDirectionTags(t T) T {
    val direction = (m Message) => m match {
        case MsgTaskAssignment(_) => "engine->agent"
        case MsgAnswer(_)         => "engine->agent"
        case MsgProgressEvent(_)  => "agent->engine"
        case MsgResult(_)         => "agent->engine"
        case MsgClarification(_)  => "agent->engine"
        case MsgVerdict(_)        => "reviewer->engine"
    }
    val t1 = Eq(t, direction(MsgTaskAssignment(Payload = sampleAssignment())), "engine->agent")
    return Eq(t1, direction(MsgVerdict(Payload = Verdict(
        Task = TaskId(Value = "task-1"), Outcome = Reject(),
        Reasons = ArrayOf[string]("drift"),
    ))), "reviewer->engine")
}

// ----------------------------------------------------------------------------
// VerdictOutcome is sealed & exhaustively matchable
// ----------------------------------------------------------------------------

func outcomeTag(o VerdictOutcome) string =
    o match {
        case Accept() => "accept"
        case Reject() => "reject"
    }

func TestVerdictOutcomeExhaustive(t T) T {
    val t1 = Eq(t, outcomeTag(Accept()), "accept")
    return Eq(t1, outcomeTag(Reject()), "reject")
}

// ----------------------------------------------------------------------------
// MockRunner round-trip — the extraction seam
// ----------------------------------------------------------------------------

// TestMockRunnerRoundTrip drives a TaskAssignment through the MockRunner and
// asserts the transcript: at least one ProgressEvent step, the first step IS a
// ProgressEvent, the terminal Result is present, and the join TaskId survives.
func TestMockRunnerRoundTrip(t T) T {
    val runner = MockRunner()
    val transcript = runner.Submit(sampleAssignment())

    // at least one streamed step before the terminal result
    val t1 = GreaterOrEq(t, transcript.Steps.Length(), 1)

    // the first step is a ProgressEvent in the Reading phase
    val t2 = transcript.Steps.Get(0) match {
        case StepProgress(ev) => ev.Phase match {
            case Reading()   => IsTrue(t1, true)
            case Emitting()  => Fail(t1, "first step should be Reading, got Emitting")
            case Verifying() => Fail(t1, "first step should be Reading, got Verifying")
        }
        case StepClarification(_) => Fail(t1, "first step should be a ProgressEvent")
    }

    // the terminal Result carries the assignment's TaskId
    val t3 = Eq(t2, transcript.Final.Task.Value, "task-1")
    return Eq(t3, transcript.Final.TargetText, "// mock translation")
}

// TestMockRunnerCancel confirms the port's second method returns a pure,
// matchable CancelOutcome.
func TestMockRunnerCancel(t T) T {
    val runner = MockRunner()
    return runner.Cancel(TaskId(Value = "task-1")) match {
        case Cancelled()  => IsTrue(t, true)
        case NotRunning() => Fail(t, "mock cancel should report Cancelled")
    }
}
