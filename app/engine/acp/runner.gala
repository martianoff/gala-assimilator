package acp

// AgentRunner — the ACP port the engine calls through to drive an agent, plus
// the deterministic MockRunner that marks the GALA-TEAM extraction seam.
//
// Stays pure-data and transport-neutral: no gala_tui, no app/ui, no IO. See the
// package doc in messages.gala for the full invariant list.

import (
    . "martianoff/gala/collection_immutable"
)

// ----------------------------------------------------------------------------
// Run transcript — the chosen stream representation
// ----------------------------------------------------------------------------

// STREAM-REPRESENTATION CHOICE: an event-list result (a pure RunTranscript),
// NOT a pull-based sequence or a callback sink.
//
// The contract says `Submit` yields a stream of ProgressEvent | Clarification
// that terminates in a Result. We model that "stream" as plain immutable data:
// an ordered Array of intermediate steps plus the single terminal Result as its
// own non-optional field.
//
// Why this shape:
//   - Purity / transport-neutrality. A pull-iterator or callback sink implies
//     suspension and side effects — exactly the IO the ACP must NOT contain.
//     A value carries no effects, so the contract stays clean and the engine
//     can keep its IIO at the edges (Cmd[T]/Async) where it belongs.
//   - The terminal-Result invariant becomes STRUCTURAL. `Final` is a separate,
//     always-present field, so "terminates in a Result" is guaranteed by the
//     type — no scanning an array hoping the last element is a result.
//   - Determinism + testability. Equal inputs give an equal transcript value,
//     which is what makes MockRunner round-trips and golden fixtures trivial.
//
// A genuinely incremental, back-pressured stream (for the live UI ticker) is an
// EDGE concern: the gala_tui layer adapts this transcript — or a future
// chunked/Cmd-based variant — into messages. That adaptation does not belong in
// the transport-neutral ACP, so it is intentionally absent here.

// RunStep is one non-terminal item the agent emits while working: a progress
// note or a question. Sealed: the terminal Result is deliberately NOT a case,
// so a RunStep can never be mistaken for the end of a run.
sealed type RunStep {
    case StepProgress(Event ProgressEvent)
    case StepClarification(Question Clarification)
}

// RunTranscript is the full outcome of a Submit: the ordered intermediate steps
// followed by exactly one terminal Result.
struct RunTranscript(
    Steps Array[RunStep],
    Final Result,
)

// CancelOutcome is the result of asking the runner to cancel a task. A pure
// acknowledgement value — the actual teardown is the implementation's IO, done
// before it returns this.
sealed type CancelOutcome {
    case Cancelled()  // the task was running and has been stopped
    case NotRunning() // no live task with that id (already done / never seen)
}

// ----------------------------------------------------------------------------
// The AgentRunner port
// ----------------------------------------------------------------------------

// AgentRunner is the ACP port: the engine's only handle on an agent backend.
//
// It is modeled as a struct of function values rather than a Go-style interface
// — the GALA-idiomatic way to express a port (cf. gala_tui's `Program`, which
// carries `Update`/`View` the same way). A backend is a value you can build,
// pass, and swap; tests inject a MockRunner with no subtyping ceremony.
//
//   Submit: TaskAssignment -> RunTranscript (the stream-as-data, see above).
//   Cancel: TaskId         -> CancelOutcome.
//
// The function values themselves are pure from the ACP's point of view; a real
// backend performs its IO inside them and hands back the resulting value. Both
// signatures stay free of gala_tui / app/ui types.
struct AgentRunner(
    Submit func(TaskAssignment) RunTranscript,
    Cancel func(TaskId) CancelOutcome,
)

// ----------------------------------------------------------------------------
// EXTENSION SEAM — where GALA-TEAM's extracted implementation plugs in
// ----------------------------------------------------------------------------
//
// MockRunner is the seam marker and the only AgentRunner this contract ships.
// It satisfies the port DETERMINISTICALLY so the engine and its tests have a
// real value to run against before the production backend exists.
//
// GALA-TEAM's extracted runner replaces THIS constructor (or sits beside it as
// e.g. `func GalaTeamRunner(cfg ...) AgentRunner`). The expected production
// behavior, which the mock only stubs:
//   - Submit: actually dispatch the unit to a live agent, collecting real
//     ProgressEvents (and any Clarifications) into Steps and the agent's true
//     output into Final; raise UnsupportedFlags for any non-faithful construct
//     instead of guessing.
//   - Cancel: signal the live task to stop and report whether one was running.
//
// Nothing here invents GALA-TEAM internals — the seam is exactly a mock plus
// this description of the contract the real implementation must honor.
func MockRunner() AgentRunner =
    AgentRunner(
        Submit = (assignment) => mockSubmit(assignment),
        Cancel = (_) => Cancelled(),
    )

// mockSubmit produces a fixed, faithful-shaped transcript: at least one
// ProgressEvent then a terminal Result, echoing the assignment's TaskId so the
// join key is observable in tests.
func mockSubmit(assignment TaskAssignment) RunTranscript {
    val task = assignment.Task
    val steps = ArrayOf[RunStep](
        StepProgress(Event = ProgressEvent(
            Task  = task,
            Phase = Reading(),
            Note  = "reading source unit",
        )),
        StepProgress(Event = ProgressEvent(
            Task  = task,
            Phase = Emitting(),
            Note  = "emitting target text",
        )),
    )
    val result = Result(
        Task       = task,
        TargetText = "// mock translation",
        Rationale  = "deterministic mock output (extraction seam stub)",
        Flags      = EmptyArray[UnsupportedFlag](),
    )
    return RunTranscript(Steps = steps, Final = result)
}
