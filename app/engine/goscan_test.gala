package engine

// Proof that the engine runs on REAL Go source. These tests write a tiny two-
// package Go project to a fresh temp directory and scan it from disk (no stub),
// then plan + run it to completion through the GoEngine port.
//
// Why a temp dir instead of a checked-in testdata/ fixture: `gala test` executes
// from the generated workspace tree, which does NOT copy a source-tree testdata/
// directory, so a package-relative path would read an empty directory. Creating
// the fixture on disk at runtime exercises the real filesystem scanner faithfully
// and is independent of the test's working directory.

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/test"
    "martianoff/gala/fs"
    "martianoff/gala/path"
    strings "martianoff/gala/strings"
)

// materializeFixture writes the fixture project to a fresh temp dir and returns
// its root: a module root holding main.go (which imports mathx) and a mathx
// package with add.go (SourceUnit) + add_test.go (SourceTest).
func materializeFixture() string {
    val root = fs.MkdirTemp("", "gala-scan-").GetOrElse(".")
    fs.WriteFileString(
        path.Join(root, "go.mod"),
        "module example.com/simpleproj\n\ngo 1.21\n",
        420)
    fs.WriteFileString(
        path.Join(root, "main.go"),
        "package main\n\nimport (\n\t\"fmt\"\n\n\t\"example.com/simpleproj/mathx\"\n)\n\nfunc main() {\n\tfmt.Println(mathx.Add(2, 3))\n}\n",
        420)
    val mathx = path.Join(root, "mathx")
    fs.MkdirAll(mathx, 493)
    fs.WriteFileString(
        path.Join(mathx, "add.go"),
        "package mathx\n\n// Add returns the sum of two integers.\nfunc Add(a, b int) int {\n\treturn a + b\n}\n",
        420)
    fs.WriteFileString(
        path.Join(mathx, "add_test.go"),
        "package mathx\n\nimport \"testing\"\n\nfunc TestAdd(t *testing.T) {\n\tif Add(2, 3) != 5 {\n\t\tt.Fatalf(\"Add(2, 3) wrong\")\n\t}\n}\n",
        420)
    return root
}

// ----------------------------------------------------------------------------
// Scan: packages, units, kinds, cross-edge, real source text
// ----------------------------------------------------------------------------

// Two packages are discovered: the module root (".", holding main.go) and "mathx".
func TestScanRealPackages(t T) T {
    val m = ScanGoWorkspace(materializeFixture())
    val t1 = Eq(t, m.Packages.Length(), 2)
    val t2 = Eq(t1, m.PackageMap.Size(), 2)
    return m.PackageMap.Get("mathx") match {
        case Some(p) => Eq(t2, p.ModulePath, "example.com/simpleproj/mathx")
        case None()  => Fail(t2, "expected a discovered 'mathx' package")
    }
}

// The root package carries main.go honoring the go.mod module path.
func TestScanRootPackage(t T) T {
    val m = ScanGoWorkspace(materializeFixture())
    return m.PackageMap.Get(".") match {
        case Some(p) => {
            val t1 = Eq(t, p.ModulePath, "example.com/simpleproj")
            return Eq(t1, p.Units.Length(), 1)
        }
        case None() => Fail(t, "expected the module-root package keyed '.'")
    }
}

// mathx has exactly the two units, classified correctly: add (SourceUnit) and
// add_test (SourceTest), and real file content is populated for the source unit.
func TestScanUnitKindsAndSource(t T) T {
    val m = ScanGoWorkspace(materializeFixture())
    return m.PackageMap.Get("mathx") match {
        case Some(p) => {
            val t1   = Eq(t, p.Units.Length(), 2)
            val add  = findUnit(p, "mathx/add")
            val test = findUnit(p, "mathx/add_test")
            val t2 = add match {
                case Some(u) => {
                    val a = Eq(t1, kindTag(u.Kind), "source")
                    return Eq(a, strings.Contains(u.Source, "func Add"), true)
                }
                case None() => Fail(t1, "expected unit mathx/add")
            }
            return test match {
                case Some(u) => Eq(t2, kindTag(u.Kind), "source_test")
                case None()  => Fail(t2, "expected unit mathx/add_test")
            }
        }
        case None() => Fail(t, "expected a discovered 'mathx' package")
    }
}

// The cross-package edge is recovered from main.go's import of mathx: . -> mathx.
func TestScanCrossEdge(t T) T {
    val m  = ScanGoWorkspace(materializeFixture())
    val t1 = Eq(t, m.CrossEdges.Length(), 1)
    val e  = m.CrossEdges.Head()
    val t2 = Eq(t1, e.From, ".")
    return Eq(t2, e.To, "mathx")
}

// SourceTestCount counts the 1:1 source tests only — exactly one (mathx/add_test).
func TestScanSourceTestParity(t T) T =
    Eq(t, SourceTestCount(ScanGoWorkspace(materializeFixture())), 1)

// ----------------------------------------------------------------------------
// Plan + run: real source flows into the plan; the run goes 0 -> 100%
// ----------------------------------------------------------------------------

// The plan carries each unit's REAL file content, not a synthesized placeholder.
func TestPlanCarriesRealSource(t T) T {
    val port = GoEngine()
    val plan = port.Plan(port.Scan(ScanRequest(Root = materializeFixture())))
    return plan.Items.Find((it PlanItem) => it.Unit.Value == "mathx/add") match {
        case Some(it) => Eq(t, strings.Contains(it.Source.SourceText, "func Add"), true)
        case None()   => Fail(t, "expected a plan item for mathx/add")
    }
}

// Full pipeline on real input: scan -> plan -> run -> RunToCompletion drives every
// unit from Queued (0% done) to Done (100% done) via the MockTranslator.
func TestRealProjectRunsToCompletion(t T) T {
    val port  = GoEngine()
    val plan  = port.Plan(port.Scan(ScanRequest(Root = materializeFixture())))
    val start = port.Run(plan)
    val total = plan.Items.Length()

    val t1 = Eq(t, CountByDone(start), 0)        // 0% done before advancing
    val final = RunToCompletion(port, start)
    val t2 = Eq(t1, total, 3)                    // main + add + add_test
    return Eq(t2, CountByDone(final), total)     // 100% reach Done
}

// findUnit looks a unit up within a package by its id value.
func findUnit(p Package, id string) Option[Unit] =
    p.Units.Find((u Unit) => u.Id.Value == id)
