package main

import (
    . "github.com/martianoff/gala-assimilator/app/ui"
    "github.com/martianoff/gala-assimilator/app/engine"
)

// Entry point: hand the TUI the engine's backend factory. The S1 "Agent
// backend" choice (Go / Mock / Claude) decides which name is passed to
// engine.SelectBackend when a scan starts, and that port drives the run —
// "claude" is the live backend, "go"/"mock" stay offline. The UI never picks
// the engine itself; it just drives whatever the factory returns.
func main() {
    RunApp((name string) => engine.SelectBackend(name))
}
