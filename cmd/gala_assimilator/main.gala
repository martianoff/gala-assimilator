package main

import (
    . "github.com/martianoff/gala-assimilator/app/ui"
    "github.com/martianoff/gala-assimilator/app/engine"
)

// Entry point: wire the engine's public port into the TUI and launch it.
// GoEngine() scans the real Go project the user points S1 at and drives it
// through the same port the UI consumes; swap to engine.MockEngine() for a
// deterministic fixture-only run. The UI drives whatever port it is given.
func main() {
    RunApp(engine.GoEngine())
}
