package main

import (
    . "github.com/martianoff/gala-assimilator/app/ui"
    "github.com/martianoff/gala-assimilator/app/engine"
)

// Entry point: wire the engine's public port into the TUI and launch it.
// GoEngine() is the real frontend — it scans the actual Go project the user
// points S1 at (translation is still the mock translator until the real agent
// backend is unblocked). Swap to engine.MockEngine() for a fixture-only run.
func main() {
    RunApp(engine.GoEngine())
}
